[Unit]
Description=Cópia em tempo real dos logs do sistema Microduck para o cartão (gravação a cada segundo, preservada se a alimentação for desconectada)
After=systemd-journald.service
[Service]
Type=simple
User=duck
ExecStart=/bin/bash -c "exec python3 /home/duck/tools/duck_journal.py /home/duck/r17/rec/journal-$(date +%%Y%%m%%d-%%H%%M%%S)-b$(cut -c1-6 /proc/sys/kernel/random/boot_id).log"
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
