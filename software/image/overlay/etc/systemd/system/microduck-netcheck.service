[Unit]
Description=Monitor de rede do Microduck (ativa o ponto de acesso se não conseguir conectar ao Wi-Fi)
After=NetworkManager.service microduck-firstboot.service
Wants=NetworkManager.service
[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/microduck-netcheck
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
