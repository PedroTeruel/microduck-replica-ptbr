#!/usr/bin/python3
"""Inicialização do Microduck na primeira partida: define o nome, configura o ponto de acesso e identifica a IMU do tronco.

Projetado para ser testado em um diretório temporário: todos os caminhos absolutos são relativos a root (padrão /),
e comandos externos e sondagens I²C podem ser injetados."""
import argparse
import ctypes
import errno
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import time
import uuid
from dataclasses import dataclass
from pathlib import Path

try:
    import tomllib
except ImportError:  # pragma: no cover - a imagem usa Python 3.13
    tomllib = None  # type: ignore[assignment]

DEFAULT_ROOT = os.environ.get("MICRODUCK_ROOT", "/")
IS_ROOT = hasattr(os, "geteuid") and os.geteuid() == 0

TRUNK_HEADER_RE = re.compile(
    r"^\s*\[\s*(?:\"trunk_imu\"|'trunk_imu'|trunk_imu)\s*\]\s*(?:#.*)?$")
ANY_HEADER_RE = re.compile(r"^\s*\[\[?.*\]\]?\s*(?:#.*)?$")


@dataclass
class Result:
    returncode: int = 0
    stdout: str = ""
    stderr: str = ""


def _default_run(args, timeout=10):
    try:
        proc = subprocess.run(args, capture_output=True, text=True,
                              encoding="utf-8", errors="replace", timeout=timeout)
        return Result(proc.returncode, proc.stdout, proc.stderr)
    except FileNotFoundError as exc:
        return Result(127, "", str(exc))
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        return Result(124, out, err + "\nTempo limite excedido")
    except OSError as exc:
        return Result(126, "", str(exc))


def clean_serial(raw):
    """Remove NUL e espaços em branco; retorna None se não for ASCII imprimível."""
    if raw is None:
        return None
    value = raw.replace(b"\x00", b"").strip()
    if not value:
        return None
    if any(byte < 0x20 or byte > 0x7E for byte in value):
        return None
    return value


def hostname_from_seed(seed):
    """Algoritmo oficial de identidade do configd: representação hexadecimal dos dois primeiros bytes do SHA-256."""
    return "duck-" + hashlib.sha256(seed).digest()[:2].hex()


# Mantém um nome mais simples por compatibilidade com testes e scripts externos.
duck_name = hostname_from_seed


def _atomic_write(path, data, mode=0o644, stat_info=None):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / (".%s.tmp.%d.%s" % (path.name, os.getpid(), secrets.token_hex(3)))
    try:
        with open(tmp, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        if stat_info is not None and IS_ROOT and hasattr(os, "chown"):
            os.chown(tmp, stat_info.st_uid, stat_info.st_gid)
        os.replace(tmp, path)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


def _file_stat(path):
    try:
        return os.stat(path)
    except OSError:
        return None


def _mode_of(stat_info, default=0o644):
    return (stat_info.st_mode & 0o7777) if stat_info is not None else default


class _I2CMessage(ctypes.Structure):
    _fields_ = [("addr", ctypes.c_uint16), ("flags", ctypes.c_uint16),
                ("len", ctypes.c_uint16), ("buf", ctypes.POINTER(ctypes.c_uint8))]


class _I2CRdWr(ctypes.Structure):
    _fields_ = [("msgs", ctypes.POINTER(_I2CMessage)), ("nmsgs", ctypes.c_uint32)]


class _I2CDev:
    """Abre o nó i2c-dev e aplica flock, como no robotd."""

    def __init__(self, path):
        import fcntl
        self._fcntl = fcntl
        self.fd = os.open(path, os.O_RDWR)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise

    def select(self, addr):
        self._fcntl.ioctl(self.fd, 0x0703, addr)  # I2C_SLAVE

    def register(self, addr, reg):
        out, back = (ctypes.c_uint8 * 1)(reg), (ctypes.c_uint8 * 1)()
        msgs = (_I2CMessage * 2)(
            _I2CMessage(addr, 0, 1, out),
            _I2CMessage(addr, 0x0001, 1, back),  # I2C_M_RD
        )
        self._fcntl.ioctl(self.fd, 0x0707, _I2CRdWr(msgs, 2))  # I2C_RDWR
        return back[0]

    def read4(self, addr):
        data = os.read(self.fd, 4)
        if len(data) != 4:
            raise OSError(errno.EIO, "read %d of 4 bytes" % len(data))
        return data

    def close(self):
        os.close(self.fd)


class _FakeDev:
    """Para testes: usa o mesmo select/register/read4, com respostas fornecidas por JSON."""

    def __init__(self, path, spec, counts):
        self.path = path
        self.spec = spec
        self.counts = counts
        bus = spec.get(path)
        if bus is None:
            raise FileNotFoundError(errno.ENOENT, "No such file or directory", path)
        if bus.get("open_error"):
            raise OSError(getattr(errno, bus["open_error"]), bus["open_error"], path)
        held = bus.get("held")
        if held and (not held.get("while_file")
                     or Path(held["while_file"]).read_text(encoding="utf-8").strip() == "active"):
            raise BlockingIOError(errno.EWOULDBLOCK, "Resource temporarily unavailable", path)
        self.bus = bus

    def op(self, text):
        if self.spec.get("_ops_log"):
            with open(self.spec["_ops_log"], "a", encoding="utf-8") as fh:
                fh.write("%s %s\n" % (self.path, text))

    def fail(self, code):
        raise OSError(getattr(errno, code), code)

    def nth(self, key, value):
        if not isinstance(value, list):
            return value
        n = self.counts[key] = self.counts.get(key, -1) + 1
        return value[min(n, len(value) - 1)]

    def scripted(self, addr):
        key = "%#04x" % addr
        if key in self.bus.get("errors", {}):
            self.fail(self.bus["errors"][key])
        seq = self.bus.get("flaky", {}).get(key)
        if seq:
            n = self.counts[(self.path, key)] = self.counts.get((self.path, key), -1) + 1
            if seq[min(n, len(seq) - 1)] != "ok":
                self.fail(seq[min(n, len(seq) - 1)])

    def select(self, addr):
        self.op("SLAVE %#04x" % addr)
        if "%#04x" % addr in self.bus.get("busy", []):
            self.fail("EBUSY")

    def register(self, addr, reg):
        self.op("RDWR %#04x" % addr)
        self.scripted(addr)
        regs = self.bus.get("regs", {}).get("%#04x" % addr)
        if regs is None:
            self.fail("ENXIO")
        return int(self.nth((self.path, "reg", addr, reg),
                            regs.get("%#04x" % reg, "0x00")), 16)

    def read4(self, addr):
        self.op("READ %#04x" % addr)
        self.scripted(addr)
        raw = self.bus.get("raw", {}).get("%#04x" % addr)
        if raw is None:
            self.fail("ENXIO")
        return bytes.fromhex(self.nth((self.path, "raw", addr), raw))

    def close(self):
        pass


def _errno_name(exc):
    return errno.errorcode.get(exc.errno, str(exc.errno)) if getattr(exc, "errno", None) \
        else type(exc).__name__


def _lock_holder(path, fake_spec=None):
    """Processo que mantém flock no nó (comm, pid); retorna (None, None) se não for possível determinar."""
    if fake_spec is not None:
        bus = fake_spec.get(path) or {}
        return (bus.get("held") or {}).get("by"), None
    try:
        st = os.stat(path)
        node = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
        with open("/proc/locks", encoding="ascii") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) < 6 or parts[1] != "FLOCK":
                    continue
                major, minor, inode = parts[5].split(":")
                if (int(major, 16), int(minor, 16), int(inode)) == node:
                    with open("/proc/%s/comm" % parts[4], encoding="utf-8") as comm:
                        return comm.read().strip(), parts[4]
    except (OSError, ValueError, IndexError):
        pass
    return None, None


def _bno_header(data):
    length, channel = (data[0] | data[1] << 8) & 0x7FFF, data[2]
    return length, channel, (length == 0 or 4 <= length <= 4096) and channel <= 5


def _show(seen):
    kind, value, why = seen
    if kind == "absent":
        return "Sem resposta (%s)" % why
    if kind == "error":
        return "Erro (%s)" % why
    if isinstance(value, bytes):
        length, channel, _ = _bno_header(value)
        return "Cabeçalho %s (comprimento %d, canal %d)" % (value.hex(" "), length, channel)
    return "%#04x" % value


def _look(dev, addr, reg):
    """Lê duas vezes com intervalo de 20 ms e retorna (estado, valor, texto)."""
    seen = []
    for attempt in range(2):
        if attempt:
            time.sleep(0.02)
        try:
            dev.select(addr)
        except OSError as exc:
            if exc.errno == errno.EBUSY:
                return "busy", None, "EBUSY: o driver do kernel está usando este endereço; não foi feita a leitura"
            return "error", None, "Falha em I2C_SLAVE (%s)" % _errno_name(exc)
        try:
            seen.append(("value", dev.register(addr, reg) if reg is not None
                         else dev.read4(addr), ""))
        except OSError as exc:
            seen.append(("absent" if exc.errno in Firstboot.NO_ANSWER else "error",
                         None, _errno_name(exc)))
    text = " / ".join(_show(s) for s in seen)
    if any(s[0] == "error" for s in seen):
        return "error", None, text
    same = [((s[0], _bno_header(s[1])[2]) if reg is None and s[0] == "value" else s[:2])
            for s in seen]
    if same[0] != same[1]:
        return "unstable", None, text
    return seen[0][0], seen[0][1], text


class Firstboot:
    def __init__(self, root=DEFAULT_ROOT, *, run_cmd=None, fake_bus=None,
                 now=None, log_stream=None, random_bytes=None):
        self.root = Path(root or "/")
        self.run_cmd = run_cmd
        self.fake_bus = fake_bus
        self.now = now if now is not None else (lambda: time.time())
        self.out = log_stream if log_stream is not None else sys.stdout
        self.random_bytes = random_bytes or secrets.token_bytes
        self.hostname = None
        self._log_warned = False

    # ---- Caminhos e registros ----

    def path(self, absolute):
        absolute = str(absolute)
        if absolute == "/":
            return self.root
        return self.root / absolute.lstrip("/")

    def log(self, message):
        message = str(message)
        print(message, file=self.out, flush=True)
        try:
            log_path = self.path("/var/log/microduck-firstboot.log")
            log_path.parent.mkdir(parents=True, exist_ok=True)
            with open(log_path, "a", encoding="utf-8", newline="\n") as fh:
                fh.write(message + "\n")
        except OSError as exc:
            if not self._log_warned:
                self._log_warned = True
                print("Aviso: falha ao gravar o registro do firstboot: %s" % exc, file=sys.stderr, flush=True)

    def _call(self, args, timeout=10):
        runner = self.run_cmd or _default_run
        try:
            return runner(args, timeout=timeout)
        except TypeError:
            return runner(args)

    def _run_allowed(self):
        # Em um root temporário, não altera o hostname local nem carrega módulos; um runner injetado indica que é um teste.
        return self.root == Path("/") or self.run_cmd is not None

    # ---- Definição do nome ----

    def read_serial(self):
        try:
            return clean_serial(self.path("/proc/device-tree/serial-number").read_bytes())
        except OSError:
            return None

    def read_wlan_mac(self):
        try:
            return clean_serial(self.path("/sys/class/net/wlan0/address").read_bytes())
        except OSError:
            return None

    def pick_name(self):
        serial = self.read_serial()
        if serial:
            return hostname_from_seed(serial), "número de série %s" % serial.decode("ascii")
        mac = self.read_wlan_mac()
        if mac:
            return hostname_from_seed(mac), "wlan0 MAC %s" % mac.decode("ascii")
        return "duck-" + self.random_bytes(2).hex(), "2 bytes aleatórios"

    def _read_hostname(self):
        try:
            text = self.path("/etc/hostname").read_bytes().decode("utf-8", "replace")
        except OSError:
            return ""
        for line in text.splitlines():
            if line.strip():
                return line.strip()
        return ""

    @staticmethod
    def _rewrite_hosts_text(text, old, new):
        lines = text.splitlines(keepends=True)
        out = []
        for raw in lines:
            body = raw.rstrip("\r\n")
            ending = raw[len(body):]
            stripped = body.lstrip()
            if not stripped or stripped.startswith("#"):
                out.append(raw)
                continue
            indent = body[:len(body) - len(stripped)]
            tokens = body.split()
            if not tokens:
                out.append(raw)
                continue
            if tokens[0] == "127.0.1.1":
                if len(tokens) == 1:
                    tokens.append(new)
                else:
                    tokens[1] = new
                    if old and old != new:
                        for i in range(2, len(tokens)):
                            if tokens[i] == old:
                                tokens[i] = new
                out.append(indent + " ".join(tokens) + ending)
            elif tokens[0] == "::1":
                changed = False
                if old and old != new:
                    for i, token in enumerate(tokens):
                        if token == old:
                            tokens[i] = new
                            changed = True
                if new not in tokens:
                    tokens.append(new)
                    changed = True
                out.append((indent + " ".join(tokens) + ending) if changed else raw)
            else:
                out.append(raw)
        return "".join(out)

    def rewrite_hosts(self, old, new):
        hosts = self.path("/etc/hosts")
        stat_info = _file_stat(hosts)
        try:
            text = hosts.read_bytes().decode("utf-8")
        except OSError:
            text = "127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost %s\n" % (old or new, old or new)
        new_text = self._rewrite_hosts_text(text, old, new)
        _atomic_write(hosts, new_text.encode("utf-8"), _mode_of(stat_info, 0o644), stat_info)
        return new_text

    def setup_hostname(self):
        name, source = self.pick_name()
        old = self._read_hostname()
        hostname_path = self.path("/etc/hostname")
        stat_info = _file_stat(hostname_path)
        _atomic_write(hostname_path, (name + "\n").encode("utf-8"),
                      _mode_of(stat_info, 0o644), stat_info)
        self.rewrite_hosts(old, name)
        self.hostname = name
        self.log("Nome definido: %s -> %s" % (source, name))
        self.log("Arquivo /etc/hostname gravado: %s" % name)
        if self._run_allowed():
            result = self._call(["hostname", name], timeout=5)
            if result.returncode == 0:
                self.log("hostname %s aplicado" % name)
            else:
                self.log("Aviso: falha ao aplicar hostname %s (código %s): %s" %
                         (name, result.returncode, (result.stderr or result.stdout).strip()))
        return name

    # ---- Configuração do ponto de acesso ----

    @staticmethod
    def _hotspot_text(suffix):
        return (
            "[connection]\n"
            "id=Microduck-Hotspot\n"
            "uuid=%s\n"
            "type=wifi\n"
            "interface-name=wlan0\n"
            "autoconnect=false\n"
            "[wifi]\n"
            "mode=ap\n"
            "ssid=Microduck-%s\n"
            "band=bg\n"
            "channel=6\n"
            "[wifi-security]\n"
            "key-mgmt=wpa-psk\n"
            "proto=rsn\n"
            "pairwise=ccmp\n"
            "group=ccmp\n"
            "pmf=1\n"
            "psk=microduck\n"
            "[ipv4]\n"
            "method=shared\n"
            "address1=10.42.0.1/24\n"
            "[ipv6]\n"
            "method=disabled\n"
        ) % (uuid.uuid4(), suffix)

    def setup_hotspot(self, name, force=False):
        suffix = name.split("-", 1)[1] if "-" in name else name
        target = self.path("/etc/NetworkManager/system-connections/Microduck-Hotspot.nmconnection")
        if (target.exists() or target.is_symlink()) and not force:
            self.log("Configuração do ponto de acesso já existe; não foi sobrescrita: %s" % target)
            return target
        if target.exists() or target.is_symlink():
            self.log("Regravando configuração do ponto de acesso: %s" % target)
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(target.parent, 0o755)
        except OSError:
            pass
        _atomic_write(target, self._hotspot_text(suffix).encode("utf-8"), 0o600)
        if IS_ROOT and hasattr(os, "chown"):
            try:
                os.chown(target, 0, 0)
            except OSError:
                pass
        self.log("Configuração gravada: Microduck-Hotspot (SSID Microduck-%s, endereço 10.42.0.1/24)" % suffix)
        return target

    # ---- IMU ----

    I2C_BUSES = ("/dev/i2c-3", "/dev/i2c-4")
    I2C_SLAVE, I2C_RDWR, I2C_M_RD = 0x0703, 0x0707, 0x0001
    BNO_ADDRS, LSM_ADDRS = (0x4A, 0x4B), (0x6A, 0x6B)
    ACC_ADDR, GYRO_ADDR = 0x19, 0x68
    WHO_AM_I, LSM_ID, ACC_ID, GYRO_ID = 0x0F, 0x70, 0x1E, 0x0F
    NO_ANSWER = {errno.ENXIO, getattr(errno, "EREMOTEIO", errno.ENXIO)}

    def _load_fake_bus(self):
        spec = json.loads(Path(self.fake_bus).read_text(encoding="utf-8"))
        after = spec.get("_after_stop")
        if after and Path(after["file"]).read_text(encoding="utf-8").strip() != "active":
            spec = dict(after["bus"], _ops_log=spec.get("_ops_log"))
        return spec

    def _detect_i2c(self):
        """Usa as mesmas regras de identificação de probe_i2c em imu-module-install.sh."""
        events = []

        def emit(kind, text):
            events.append((kind, text))

        fake_spec = self._load_fake_bus() if self.fake_bus else None
        fake_counts = {}
        cands, unsure, hints, buses, held = [], [], [], 0, 0
        for path in self.I2C_BUSES:
            wire = "J5 (i2c3-pihat)" if path.endswith("3") else "pinos 27/28 do conector de 40 pinos (i2c4-m0)"
            try:
                dev = _FakeDev(path, fake_spec, fake_counts) if fake_spec is not None \
                    else _I2CDev(str(self.path(path)))
            except FileNotFoundError:
                emit("WARN", "%s não existe: overlay de %s não está habilitado; este barramento não será sondado" % (path, wire))
                continue
            except BlockingIOError:
                comm, pid = _lock_holder(path if fake_spec is not None
                                         else str(self.path(path)), fake_spec)
                who = "%s, pid %s" % (comm, pid) if comm and pid else comm or "outro processo"
                emit("WARN", "%s está sendo usado por %s (mesmo flock); este barramento não será sondado" % (path, who))
                emit("HELD", "%s %s" % (path, comm or "?"))
                unsure.append("%s está sendo usado por %s; não foi sondado" % (path, who))
                held += 1
                continue
            except OSError as exc:
                emit("WARN", "%s não pode ser aberto (%s)" % (path, _errno_name(exc)))
                unsure.append("%s não pode ser aberto (%s)" % (path, _errno_name(exc)))
                continue
            buses += 1
            try:
                found = {addr: _look(dev, addr, None) for addr in self.BNO_ADDRS}
                found.update({addr: _look(dev, addr, self.WHO_AM_I) for addr in self.LSM_ADDRS})
                if path == "/dev/i2c-3":
                    found.update({addr: _look(dev, addr, 0x00)
                                  for addr in (self.ACC_ADDR, self.GYRO_ADDR)})
            finally:
                dev.close()
            for addr, (state, value, text) in found.items():
                what = "cabeçalho BNO08x" if addr in self.BNO_ADDRS else \
                    "WHO_AM_I" if addr in self.LSM_ADDRS else "chip ID"
                emit("LOG", "%s %#04x %s：%s" % (path, addr, what, text))
            for addr in self.BNO_ADDRS:
                state, value, text = found[addr]
                if state == "absent":
                    continue
                if state == "value" and _bno_header(value)[2]:
                    cands.append(("bno08x", path, addr))
                    continue
                unsure.append("%s %#04x " % (path, addr) + {
                    "busy": "ocupado pelo driver do kernel",
                    "error": "erro de leitura: %s" % text,
                    "unstable": "leituras divergentes: %s" % text,
                }.get(state, "respondeu, mas não parece ser um BNO08x: %s" % text))
                if state == "value" and value == b"\xff\xff\xff\xff":
                    hints.append("%s %#04x retornou ff ff ff ff: o BNO08x pode estar reiniciando; tente novamente em alguns segundos"
                                 % (path, addr))
            lsm = []
            for addr in self.LSM_ADDRS:
                state, value, text = found[addr]
                if state == "absent":
                    continue
                if state == "value" and value == self.LSM_ID:
                    lsm.append(addr)
                    continue
                unsure.append("%s %#04x " % (path, addr) + {
                    "busy": "ocupado pelo driver do kernel",
                    "error": "erro de leitura: %s" % text,
                    "unstable": "leituras divergentes: %s" % text,
                }.get(state, "respondeu, mas WHO_AM_I não é 0x70: %s" % text))
                if state == "value":
                    hints.append("%s %#04x retornou WHO_AM_I diferente de 0x70: o LSM6DSV16X pode estar na página"
                                 " de registradores de funções embutidas; desligue e ligue novamente" % (path, addr))
                if state == "busy" and path == "/dev/i2c-3" and addr == 0x6A:
                    hints.append(
                        "O endereço 0x6A em J5 está ocupado pelo driver do kernel. Na HAT D1, pode ser a IMU integrada. "
                        "Confirme que o módulo do tronco está em 0x6B; então use o comando explícito: "
                        "install <diretório> lsm6dsv16x /dev/i2c-3 0x6B")
            if path == "/dev/i2c-4":
                cands += [("lsm6dsv16x", path, addr) for addr in lsm]
                continue
            c1 = (found[self.ACC_ADDR][:2] == ("value", self.ACC_ID)
                  and found[self.GYRO_ADDR][:2] == ("value", self.GYRO_ID))
            for addr in (self.ACC_ADDR, self.GYRO_ADDR):
                state, value, text = found[addr]
                if state in ("error", "unstable"):
                    unsure.append("%s %#04x (endereço do BMI088)" % (path, addr)
                                  + ("falha de leitura" if state == "error" else "leituras divergentes")
                                  + ": %s; este barramento pode estar com defeito, então a ausência de resposta em outros endereços também não é confiável" % text)
            emit("LOG", "%s: %s" % (
                path,
                "HAT C1 identificada (BMI088 0x19 = 0x1e e 0x68 = 0x0f)" if c1 else
                "HAT C1 não identificada (os dois valores de identificação do BMI088 não coincidiram)"))
            if c1:
                cands += [("lsm6dsv16x", path, addr) for addr in lsm]
            elif lsm == [0x6A, 0x6B]:
                emit("LOG", "%s: 0x6a ignorado como IMU da cabeça integrada à HAT D1; 0x6b tratado como módulo do tronco" % path)
                cands.append(("lsm6dsv16x", path, 0x6B))
            elif lsm == [0x6A]:
                emit("LOG", "%s: 0x6a identificado como IMU da cabeça integrada à HAT D1, não como módulo do tronco; não há módulo do tronco neste barramento" % path)
                hints.append(
                    "HAT D1: configure o módulo do tronco em J5 para 0x6B (SA0 do módulo conectado a 3,3 V). "
                    "0x6A na D1 é a IMU integrada. Só use o comando explícito para 0x6A se confirmar que a HAT é C1 (com BMI088) "
                    "e que somente a leitura do BMI088 falhou: install <diretório> lsm6dsv16x /dev/i2c-3 0x6A")
            elif lsm == [0x6B]:
                unsure.append("%s tem um LSM6DSV16X em 0x6b, mas não foi identificada a HAT C1 nem a IMU 0x6a integrada à D1; "
                              "não é possível saber se é o módulo do tronco ou a IMU da cabeça" % path)
                hints.append(
                    "Somente 0x6B em J5: pode ser uma HAT D1 com R30 mal soldado (a IMU integrada foi parar em 0x6B), "
                    "uma HAT C1 cujo BMI088 não responde ou uma HAT desconectada. Verifique a HAT e confirme que 0x6B é o módulo do tronco; "
                    "então use: install <diretório> lsm6dsv16x /dev/i2c-3 0x6B")
        if not buses and not unsure:
            hints.append("/dev/i2c-3 e /dev/i2c-4 não existem: J5 requer o overlay i2c3-pihat;")
            hints[-1] += " os pinos 27/28 requerem i2c4-m0 (consulte IMU-MODULE.md)."
        for source, path, addr in cands:
            emit("CAND", "%s %s %s" % (source, path, addr))
        for why in unsure:
            emit("UNSURE", why)
        for hint in hints:
            emit("HINT", hint)
        emit("COUNTS", "%s %s" % (len(cands), len(unsure) - held))
        verdict = "unsure" if unsure else "one" if len(cands) == 1 else \
            "many" if cands else "none"
        emit("VERDICT", verdict)
        candidates = [{"source": source, "device": path, "address": addr}
                      for source, path, addr in cands]
        log = [text for kind, text in events if kind in ("LOG", "WARN")]
        return verdict, candidates, unsure, hints, log

    def _write_imu_json(self, verdict, candidates, unsure, hints, log, written):
        target = self.path("/var/lib/microduck/imu-detect.json")
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(target.parent, 0o755)
        except OSError:
            pass
        data = {
            "at": float(self.now()),
            "verdict": verdict,
            "candidates": candidates,
            "unsure": unsure,
            "hints": hints,
            "log": log,
            "written": bool(written),
        }
        _atomic_write(target,
                      (json.dumps(data, ensure_ascii=False, indent=2) + "\n").encode("utf-8"),
                      0o644)
        return target

    @staticmethod
    def _has_trunk_imu(path):
        try:
            text = Path(path).read_bytes().decode("utf-8", "replace")
        except OSError:
            return False
        if any(TRUNK_HEADER_RE.match(line) for line in text.splitlines()):
            return True
        if tomllib is not None:
            try:
                return "trunk_imu" in tomllib.loads(text)
            except Exception:
                pass
        return False

    @staticmethod
    def _section_text(text):
        lines = text.splitlines()
        start = None
        for i, line in enumerate(lines):
            if TRUNK_HEADER_RE.match(line):
                start = i
                break
        if start is None:
            return ""
        end = len(lines)
        for j in range(start + 1, len(lines)):
            if ANY_HEADER_RE.match(lines[j]):
                end = j
                break
        while end > start + 1 and not lines[end - 1].strip():
            end -= 1
        return "\n".join(lines[start:end])

    @staticmethod
    def _remove_section(text):
        lines = text.splitlines(keepends=True)
        start = None
        for i, line in enumerate(lines):
            if TRUNK_HEADER_RE.match(line.rstrip("\r\n")):
                start = i
                break
        if start is None:
            return text
        end = len(lines)
        for j in range(start + 1, len(lines)):
            if ANY_HEADER_RE.match(lines[j].rstrip("\r\n")):
                end = j
                break
        return "".join(lines[:start] + lines[end:])

    @staticmethod
    def _toml_block(chosen):
        lines = ['["trunk_imu"]']
        lines.append('"source" = "%s"' % chosen["driver"])
        if chosen["driver"] == "bno08x":
            lines.append('"bno08x_fusion" = "gyro"')
        lines.append('"i2c_device" = "%s"' % chosen["bus"])
        lines.append('"i2c_address" = %d' % chosen["address"])
        return "\n".join(lines) + "\n"

    def _write_toml(self, path, chosen, force):
        path = Path(path)
        original_exists = path.exists()
        original = path.read_bytes() if original_exists else b""
        stat_info = _file_stat(path)
        text = original.decode("utf-8") if original_exists else ""
        if self._has_trunk_imu(path):
            if not force:
                self.log("Seção trunk_imu já existe; mantida: %s" % path)
                section = self._section_text(text)
                if section:
                    self.log(section)
                return False
            text = self._remove_section(text)
        block = self._toml_block(chosen)
        base = text.rstrip("\n")
        new_text = (base + "\n\n" if base else "") + block
        _atomic_write(path, new_text.encode("utf-8"), _mode_of(stat_info, 0o644), stat_info)
        if tomllib is None:  # pragma: no cover
            raise RuntimeError("tomllib indisponível; não é possível validar o TOML")
        try:
            tomllib.loads(new_text)
        except Exception as exc:
            if original_exists:
                _atomic_write(path, original, _mode_of(stat_info, 0o644), stat_info)
            else:
                try:
                    path.unlink()
                except OSError:
                    pass
            raise RuntimeError("Falha na validação do TOML; arquivo original restaurado: %s: %s" % (path, exc))
        self.log("Gravado %s: %s %s 0x%02x" %
                 (path, chosen["driver"], chosen["bus"], chosen["address"]))
        return True

    def _imu_targets(self):
        base = self.path("/etc/robot/feetech-ft5")
        return [base / "robotd.toml", base / "robotd.saved.toml"]

    def detect_imu(self, force=False):
        if self._run_allowed():
            result = self._call(["modprobe", "i2c-dev"], timeout=10)
            if result.returncode != 0:
                self.log("Aviso: falha ao executar modprobe i2c-dev (ignorada): %s" %
                         (result.stderr or result.stdout).strip())
        verdict, candidates, unsure, hints, log = self._detect_i2c()
        for line in log:
            self.log("Sondagem da IMU: %s" % line)
        chosen = None
        if verdict == "one":
            chosen = dict(candidates[0], driver=candidates[0]["source"],
                          bus=candidates[0]["device"])
        written = False
        errors = []
        if chosen is not None:
            self.log("Resultado da identificação da IMU: única; selecionada %s %s 0x%02x" %
                     (chosen["source"], chosen["device"], chosen["address"]))
            for target in self._imu_targets():
                try:
                    if self._write_toml(target, chosen, force):
                        written = True
                except Exception as exc:
                    errors.append("%s: %s" % (target, exc))
                    self.log("Erro: falha ao gravar %s: %s" % (target, exc))
        else:
            self.log("Resultado da identificação da IMU: %s; trunk_imu não foi gravado" % verdict)
            for candidate in candidates:
                self.log("Candidato: %s %s 0x%02x" % (candidate["source"], candidate["device"],
                                                candidate["address"]))
            for why in unsure:
                self.log("Não foi possível determinar: %s" % why)
            for hint in hints:
                self.log("Orientação: %s" % hint)
            if verdict == "none":
                self.log("Nenhuma IMU I²C encontrada; o programa principal procurará uma IMU no barramento dos servos")
        self._write_imu_json(verdict, candidates, unsure, hints, log, written)
        if errors:
            raise RuntimeError("；".join(errors))
        return chosen

    # ---- Marcador de conclusão e fluxo completo ----

    def _write_marker(self):
        target = self.path("/var/lib/microduck/firstboot.done")
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(target.parent, 0o755)
        except OSError:
            pass
        text = "%.6f %s\n" % (float(self.now()), self.hostname or "")
        _atomic_write(target, text.encode("utf-8"), 0o644)
        self.log("Marcador de conclusão gravado: %s" % target)

    def run(self, detect_only=False, force=False, hotspot_only=False):
        if hotspot_only:
            self.log("==> Reconstruindo somente a conexão do ponto de acesso")
            name = self._read_hostname()
            if not name:
                name, _ = self.pick_name()
            self.hostname = name
            try:
                self.setup_hotspot(name, force=True)
            except Exception as exc:
                self.log("Erro: falha ao reconstruir a configuração do ponto de acesso: %s" % exc)
                self.log("Resumo: não foi possível reconstruir a conexão do ponto de acesso")
                return 1
            self.log("Resumo: conexão do ponto de acesso reconstruída (SSID Microduck-%s)" %
                     (name.split("-", 1)[1] if "-" in name else name))
            return 0

        if detect_only:
            self.log("==> Identificando novamente somente a IMU do tronco")
            try:
                self.detect_imu(force=force)
            except Exception as exc:
                self.log("Resumo: falha na identificação da IMU: %s" % exc)
                return 1
            self.log("Resumo: identificação da IMU concluída")
            return 0

        failures = []
        name_ok = False
        hotspot_ok = False

        self.log("==> 1/3 Definir o nome")
        try:
            self.setup_hostname()
            name_ok = True
        except Exception as exc:
            failures.append("definição do nome")
            self.log("Erro: falha ao definir o nome: %s" % exc)

        self.log("==> 2/3 Configurar o ponto de acesso")
        try:
            name = self.hostname
            if not name:
                name, _ = self.pick_name()
                self.hostname = name
            self.setup_hotspot(name)
            hotspot_ok = True
        except Exception as exc:
            failures.append("configuração do ponto de acesso")
            self.log("Erro: falha ao configurar o ponto de acesso: %s" % exc)
            self.log("A configuração do ponto de acesso falhou; o marcador de conclusão não será gravado nesta execução. Será tentada novamente na próxima inicialização.")

        self.log("==> 3/3 Identificar a IMU do tronco")
        try:
            self.detect_imu()
        except Exception as exc:
            failures.append("identificação da IMU")
            self.log("Erro: falha ao identificar a IMU: %s" % exc)

        if name_ok and hotspot_ok:
            try:
                self._write_marker()
            except Exception as exc:
                failures.append("marcador de conclusão")
                self.log("Erro: falha ao gravar o marcador de conclusão: %s" % exc)
        elif not name_ok:
            self.log("Definição do nome falhou; o marcador de conclusão não será gravado")

        if failures:
            self.log("Resumo: %d etapas falharam: %s" % (len(failures), ", ".join(failures)))
        else:
            self.log("Resumo: todas as etapas foram concluídas")
        return 0 if name_ok else 1


def main(argv=None):
    parser = argparse.ArgumentParser(description="Inicialização do Microduck na primeira partida")
    parser.add_argument("--detect-imu-only", action="store_true", help="Identifica somente a IMU do tronco")
    parser.add_argument("--hotspot-only", action="store_true", help="Reconstrói somente a conexão do ponto de acesso; não define o nome nem identifica a IMU")
    parser.add_argument("--force", action="store_true", help="Substitui uma seção trunk_imu existente")
    parser.add_argument("--root", default=DEFAULT_ROOT,
                        help="Diretório raiz para testes (padrão /; também pode ser definido por MICRODUCK_ROOT)")
    args = parser.parse_args(argv)
    firstboot = Firstboot(root=args.root)
    return firstboot.run(detect_only=args.detect_imu_only, force=args.force,
                         hotspot_only=args.hotspot_only)


if __name__ == "__main__":
    sys.exit(main())
