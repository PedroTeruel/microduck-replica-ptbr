# Inicialização automática do Microduck Studio (decisão de 20/10: deixar de usar o studio-trial temporário via systemd-run).
# Instalar: sudo install -m 644 microduck-studio.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now microduck-studio
# Remover: sudo systemctl disable --now microduck-studio && sudo rm /etc/systemd/system/microduck-studio.service && sudo systemctl daemon-reload
# Limites de recursos iguais aos do período de teste: o Studio não deve disputar CPU com o robotd (ciclo de controle de 50 Hz).
# Não aguarda network-online: o Studio escuta em 0.0.0.0 e aceita conexões quando a rede fica disponível mais tarde; se o programa principal estiver parado, o Studio aguarda e tenta reconectar.
[Unit]
Description=Microduck Studio (painel web, porta 8000)
After=network.target

[Service]
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/studio-dev
ExecStart=/usr/bin/python3 -I run.py --listen 0.0.0.0:8000
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=20
CPUQuota=60%
MemoryMax=300M

[Install]
WantedBy=multi-user.target
