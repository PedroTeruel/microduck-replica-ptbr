# Validação de parâmetros

def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def check_by(args):
    by = args.get("by")
    if not isinstance(by, str) or not by.strip() or len(by) > 200:
        raise Stop(EXIT_ARGS, "bad_args", "by deve ser uma string de 1 a 200 caracteres (quem está fazendo a solicitação e de qual computador)")
    return by.strip()


def check_keys(obj, allowed, what):
    extra = sorted(set(obj) - set(allowed))
    if extra:
        raise Stop(EXIT_ARGS, "bad_args", f"{what} contém chaves desconhecidas: {extra}")


def check_mac(value):
    if not isinstance(value, str):
        raise Stop(EXIT_ARGS, "bad_args", "mac deve ser uma string no formato AA:BB:CC:DD:EE:FF")
    mac = value.strip().upper()
    if not MAC_RE.match(mac):
        raise Stop(EXIT_ARGS, "bad_args", f"Formato de mac inválido: {value!r} (deve ser como AA:BB:CC:DD:EE:FF)")
    return mac


def check_pad_pair_args(args):
    check_keys(args, ("by", "mac", "timeout"), "parâmetros de pad-pair")
    by = check_by(args)
    mac = args.get("mac")
    if mac is not None:
        mac = check_mac(mac)
    timeout = args.get("timeout", PAD_TIMEOUT_DEFAULT)
    if not is_int(timeout) or not PAD_TIMEOUT_MIN <= timeout <= PAD_TIMEOUT_MAX:
        raise Stop(EXIT_ARGS, "bad_args",
                   f"timeout deve ser um inteiro entre {PAD_TIMEOUT_MIN} e {PAD_TIMEOUT_MAX} segundos (padrão {PAD_TIMEOUT_DEFAULT})")
    return by, mac, timeout


def check_pad_forget_args(args):
    check_keys(args, ("by", "mac"), "parâmetros de pad-forget")
    by = check_by(args)
    if "mac" not in args:
        raise Stop(EXIT_ARGS, "bad_args", "pad-forget requer mac (o dispositivo a remover)")
    return by, check_mac(args["mac"])


JOINT_REQUIRED = ("id", "torque", "goal", "present", "offset")
JOINT_OPTIONAL = {"load": (-32767, 32767), "temp": (0, 255), "status": (0, 255)}


def build_marker(op, given, by):
    """Valida o marcador recebido do Studio e preenche boot_id e mono_ms. Rejeita ttl_ms acima de 30000 (não trunca silenciosamente)."""
    if not isinstance(given, dict):
        raise Stop(EXIT_ARGS, "bad_marker", "marker deve ser um objeto")
    check_keys(given, ("schema", "requested_by", "ttl_ms", "port", "arm_registers", "joints", "boot_id", "mono_ms"),
               "marker")
    if "schema" in given and given["schema"] != SCHEMA:
        raise Stop(EXIT_ARGS, "bad_marker", f"marker.schema aceita somente {SCHEMA}")
    rb = given.get("requested_by", by)
    if not isinstance(rb, str) or not rb or len(rb) > 200:
        raise Stop(EXIT_ARGS, "bad_marker", "marker.requested_by deve ser uma string de 1 a 200 caracteres")
    ttl = given.get("ttl_ms", TTL_DEFAULT_MS)
    if not is_int(ttl) or not TTL_MIN_MS <= ttl <= TTL_MAX_MS:
        raise Stop(EXIT_ARGS, "bad_marker", f"marker.ttl_ms deve estar entre {TTL_MIN_MS} e {TTL_MAX_MS} (robotd aceita no máximo 30 s)")
    port = given.get("port", PORT)
    if port != PORT:
        raise Stop(EXIT_ARGS, "bad_marker", f"marker.port deve ser {PORT}")
    arm = given.get("arm_registers")
    if arm is not None:
        if not isinstance(arm, dict) or set(arm) != {"limit", "p", "d"} or not all(is_int(v) for v in arm.values()) \
                or not 0 <= arm["limit"] <= 65535 or not 0 <= arm["p"] <= 255 or not 0 <= arm["d"] <= 255:
            raise Stop(EXIT_ARGS, "bad_marker", "marker.arm_registers deve ter o formato {limit 0–65535, p 0–255, d 0–255}")
    joints = given.get("joints")
    if not isinstance(joints, list) or len(joints) != 15:
        raise Stop(EXIT_ARGS, "bad_marker", "marker.joints deve conter exatamente 15 linhas")
    seen, rows = set(), []
    for j in joints:
        if not isinstance(j, dict):
            raise Stop(EXIT_ARGS, "bad_marker", "Cada linha de marker.joints deve ser um objeto")
        check_keys(j, JOINT_REQUIRED + tuple(JOINT_OPTIONAL), "uma linha de marker.joints")
        for k in JOINT_REQUIRED:
            if not is_int(j.get(k)):
                raise Stop(EXIT_ARGS, "bad_marker", f"marker.joints: {k} deve ser um inteiro ({j.get('id')})")
        jid = j["id"]
        if jid not in JOINT_IDS or jid in seen:
            raise Stop(EXIT_ARGS, "bad_marker", f"marker.joints: id {jid} não pertence às 15 articulações ou está duplicado")
        seen.add(jid)
        if j["torque"] != 1:
            raise Stop(EXIT_ARGS, "bad_marker", f"marker.joints: #{jid} está sem torque (torque deve ser 1). O programa principal só assume quando os 15 servos estão habilitados.")
        for k in ("goal", "present", "offset"):
            if not -32767 <= j[k] <= 32767:
                raise Stop(EXIT_ARGS, "bad_marker", f"marker.joints: {k} de #{jid} está fora do intervalo −32767..32767")
        for k, (lo, hi) in JOINT_OPTIONAL.items():
            if k in j and (not is_int(j[k]) or not lo <= j[k] <= hi):
                raise Stop(EXIT_ARGS, "bad_marker", f"marker.joints: {k} de #{jid} deve ser um inteiro entre {lo} e {hi}")
        rows.append({k: j[k] for k in JOINT_REQUIRED + tuple(JOINT_OPTIONAL) if k in j})
    if seen != JOINT_IDS:
        raise Stop(EXIT_ARGS, "bad_marker", f"Faltam articulações em marker.joints: {sorted(JOINT_IDS - seen)}")
    out = {"schema": SCHEMA, "requested_by": rb, "boot_id": op.ctx.boot_id(), "mono_ms": int(op.ctx.now() * 1000),
           "ttl_ms": ttl, "port": PORT, "joints": rows}
    if arm is not None:
        out["arm_registers"] = arm
    return out


# ---------------------------------------------------------------------------
# Pré-requisitos para assumir o barramento (handover-plan.md §2.1)

def judge(bus, safe, pol, allow_seated):
    """Avalia uma leitura: ("ok"|"seated"|"wait"|"refuse", motivo)."""
    if not isinstance(bus, dict):
        return "refuse", "busStatus do programa principal não é um objeto"
    phase, mode = bus.get("phase"), bus.get("mode")
    if phase in STARTING_PHASES:
        return "ok", f"O programa principal ainda está iniciando ({phase}); nenhum alvo foi enviado"
    if mode == "commissioning":
        return "ok", "Modo de calibração"
    if mode != "motion" or phase != "control":
        return "refuse", f"Estado atual do programa principal desconhecido (mode={mode}, phase={phase})"
    native = bus.get("native") if isinstance(bus.get("native"), dict) else {}
    torque = native.get("torque_state_confirmed")
    sitting = isinstance(pol, dict) and pol.get("sitting") is True
    if bus.get("policy_enabled") is True:
        if sitting:
            if not allow_seated:
                return "refuse", "Microduck sentado (rotina de sentar ativa); esta solicitação não permitiu assumir sentado"
            if not (isinstance(safe, dict) and safe.get("safe") is True):
                return "refuse", "A ação de sentar ou levantar ainda não terminou (safeToRestart não é true)"
            return "seated", "Microduck sentado; a ação de sentar terminou"
        return "refuse", "Uma rotina está ativa (em pé, habilidade ou modo de postura corporal): pressione Start no controle ou clique em “Parar”, aguarde 2 s para retornar suavemente à postura em pé e tente assumir novamente"
    if bus.get("home_recovery") is True:
        return "refuse", "O movimento de levantar iniciado por LB ainda não terminou"
    if isinstance(safe, dict) and safe.get("safe") is False:
        return "refuse", f"O programa principal informou que não pode ser interrompido agora: {safe.get('reason')}"
    if torque is False:
        return "ok", "Torque relaxado"
    if native.get("handover_hold") is True:
        return "ok", "Programa principal mantendo o controle"
    if torque is True:
        if bus.get("homed") is True:
            return "ok", "Postura em pé mantida (rotina desativada)"
        return "wait", "Retornando à postura em pé"
    return "refuse", "O programa principal não informou o estado do torque (torque_state_confirmed indisponível)"


def joint_positions(bus):
    native = bus.get("native") if isinstance(bus, dict) and isinstance(bus.get("native"), dict) else {}
    out = {}
    for j in native.get("joints") or []:
        if isinstance(j, dict) and isinstance(j.get("position_rad"), (int, float)) and not isinstance(j.get("position_rad"), bool):
            out[j.get("id")] = float(j["position_rad"])
    return out


def read_robotd(op):
    """Lê busStatus (obrigatório), safeToRestart e policies (somente na fase de controle do modo de movimento)."""
    bus = op.ctx.rpc("robot.busStatus", {}, 1.0)
    try:
        safe = op.ctx.rpc("robot.safeToRestart", {}, 1.0)
    except RpcError:
        safe = None
    pol = None
    if isinstance(bus, dict) and bus.get("mode") == "motion" and bus.get("phase") == "control":
        try:
            pol = op.ctx.rpc("robot.policies", {}, 1.0)
        except RpcError:
            pol = None
    return bus, safe, pol


def gate(op, allow_seated):
    """Lê duas vezes com intervalo de 200 ms e só permite se ambas as leituras forem válidas. Aguarda até 3 s pelo retorno à postura em pé. Retorna o motivo da aprovação; caso contrário, lança Stop(3)."""
    deadline = op.ctx.now() + HOMING_WAIT
    while True:
        if stopped(robotd_state(op)):
            return "O programa principal não está em execução"
        try:
            r1 = read_robotd(op)
            op.ctx.sleep(GATE_GAP)
            r2 = read_robotd(op)
        except RpcError as e:
            if stopped(robotd_state(op)):
                return "O programa principal não está em execução"
            raise Stop(EXIT_STATE, "refused", f"O programa principal está em execução, mas não responde: {e}. Aguarde alguns segundos e tente novamente.") from e
        v1, v2 = judge(*r1, allow_seated), judge(*r2, allow_seated)
        op.emit("gate", "info", "Duas leituras do estado do programa principal", {"first": v1, "second": v2})
        if v1[0] == "refuse" or v2[0] == "refuse":
            raise Stop(EXIT_STATE, "refused", (v2 if v2[0] == "refuse" else v1)[1])
        if v1[0] == v2[0] == "ok":
            return v2[1]
        if v1[0] == v2[0] == "seated":
            a, b = joint_positions(r1[0]), joint_positions(r2[0])
            if set(a) != set(b) or len(a) != 15:
                raise Stop(EXIT_STATE, "refused", "Microduck sentado, mas não foi possível ler as posições das 15 articulações para verificar se estão paradas")
            moved = {jid: round(abs(a[jid] - b[jid]) * 57.29578, 2) for jid in a if abs(a[jid] - b[jid]) >= STILL_RAD}
            if moved:
                raise Stop(EXIT_STATE, "refused", "Microduck sentado, mas as articulações ainda se movem (cada uma deve se mover <1° em 0,5 s)", {"moved_deg": moved})
            return "Sentado e imóvel: mantém a postura sentada atual"
        if op.ctx.now() >= deadline:
            raise Stop(EXIT_STATE, "refused", f"Não alcançou a postura em pé estável após {HOMING_WAIT:.0f} s: {v2[1]}")
        op.ctx.sleep(GATE_GAP)


# ---------------------------------------------------------------------------
# calib-read / calib-commit: lê a calibração ou grava zero/direções dos servos e orientação da IMU no arquivo de calibração do robotd.
#
# A imagem de fábrica inicia o programa principal no modo de calibração (--commissioning). Quando a gravação da etapa 3 termina, remove o drop-in da imagem
# para retornar ao modo de movimento. Sucesso exige mode=motion, phase=control e correspondência item a item entre calibration-status e os valores gravados. Se qualquer etapa da gravação falhar, restaura primeiro o backup.

CALIB_ERR = re.compile(
    r"(calibrat|motion_enabled|IMU mounting|motion requires|Feetech configuration|invalid Feetech|"
    r"single-turn|limits exclude|official home|min_rad|max_rad|verified IMU)", re.I)


def check_calib_read_args(args):
    check_keys(args, ("by",), "parâmetros de calib-read")
    return check_by(args) if "by" in args else None


def exec_start(op):
    return show(op, "robotd", ["ExecStart"]).get("ExecStart", "")


def calib_mode(op, strict=True):
    """commissioning = drop-in da imagem está presente; motion = drop-in ausente e ExecStart também não contém --commissioning.
    Se ExecStart contiver o parâmetro e o drop-in estiver ausente, o modo não foi definido pela imagem; não remove nem troca automaticamente. calib-read é somente leitura e strict=False
    informa "foreign" para mostrar o estado atual; calib-commit exige strict=True e rejeita esse caso."""
    if exists(op.ctx, COMMISSIONING_DROPIN):
        return "commissioning", "Modo de calibração; após gravar, precisa mudar para o modo de movimento"
    start = exec_start(op)
    if "--commissioning" in start:
        if strict:
            raise Stop(EXIT_STATE, "foreign_commissioning",
                       "O modo de calibração do programa principal não foi definido pela imagem; não será alterado automaticamente. Exporte o pacote de diagnóstico na página de registros.",
                       {"ExecStart": start, "commissioning_file": COMMISSIONING_DROPIN})
        return "foreign", "ExecStart contém --commissioning, mas o drop-in da imagem está ausente (não foi definido pela imagem; a gravação não mudará o modo automaticamente)"
    return "motion", "Modo de movimento; altera somente a calibração"


def calib_posture(bus):
    """Verifica a postura antes de gravar a calibração. Bloqueia somente uma rotina ativa ou servos habilitados no modo de movimento; no modo de calibração, permite normalmente."""
    if not isinstance(bus, dict):
        return "refuse", "busStatus do programa principal não é um objeto"
    mode, phase = bus.get("mode"), bus.get("phase")
    if mode == "commissioning":
        return "ok", "Modo de calibração"
    if mode != "motion":
        return "refuse", f"Estado atual do programa principal desconhecido (mode={mode}, phase={phase})"
    if phase in STARTING_PHASES:
        return "ok", f"O programa principal ainda está iniciando ({phase})"
    if phase == "waiting_for_bus":
        return "ok", "O programa principal ainda não abriu o barramento de servos (nenhuma rotina está ativa); é possível regravar a calibração"
    if phase != "control":
        return "refuse", f"O programa principal não está na fase de controle (phase={phase})"
    native = bus.get("native") if isinstance(bus.get("native"), dict) else {}
    if bus.get("policy_enabled") is True or native.get("torque_state_confirmed") is True:
        return "refuse", "O Microduck está andando ou em pé; faça-o sentar ou relaxe o torque antes de gravar"
    if bus.get("home_recovery") is True:
        return "refuse", "O movimento de levantar iniciado por LB ainda não terminou; aguarde o retorno à postura em pé antes de gravar"
    return "ok", "Programa principal em modo de movimento, sem andar nem manter postura em pé"


def calib_gate(op, mode):
    """Lê duas vezes com intervalo de 200 ms. commissioning não tem rotinas; permite com base diretamente no modo."""
    if mode == "commissioning":
        op.emit("gate", "info", "Modo de calibração: sem rotina ativa; gravação permitida")
        return "Modo de calibração"
    deadline = op.ctx.now() + HOMING_WAIT
    while True:
        if stopped(robotd_state(op)):
            return "O programa principal não está em execução"
        try:
            r1 = read_robotd(op)
            op.ctx.sleep(GATE_GAP)
            r2 = read_robotd(op)
        except RpcError as e:
            if stopped(robotd_state(op)):
                return "O programa principal não está em execução"
            raise Stop(EXIT_STATE, "refused", f"O programa principal está em execução, mas não responde: {e}. Aguarde alguns segundos e tente novamente.") from e
        v1, v2 = calib_posture(r1[0]), calib_posture(r2[0])
        op.emit("gate", "info", "Duas leituras da postura do programa principal", {"first": v1, "second": v2})
        if v1[0] == "refuse" or v2[0] == "refuse":
            raise Stop(EXIT_STATE, "refused", (v2 if v2[0] == "refuse" else v1)[1])
        if v1[0] == v2[0] == "ok":
            return v2[1]
        if op.ctx.now() >= deadline:
            raise Stop(EXIT_STATE, "refused", f"Não foi possível determinar a postura após aguardar {HOMING_WAIT:.0f} s: {v2[1]}")
        op.ctx.sleep(GATE_GAP)


def check_calib_commit_args(args):
    check_keys(args, ("by", "joints", "imu", "dry_run"), "parâmetros de calib-commit")
    by = check_by(args)
    joints = args.get("joints")
    if not isinstance(joints, list) or len(joints) != 15:
        raise Stop(EXIT_ARGS, "bad_args", "joints deve conter exatamente 15 itens {id, direction}")
    rows = []
    for row in joints:
        if not isinstance(row, dict):
            raise Stop(EXIT_ARGS, "bad_args", "Cada item de joints deve ser um objeto")
        check_keys(row, ("id", "direction"), "um item de joints")
        if not is_int(row.get("id")) or row.get("direction") not in (-1, 1):
            raise Stop(EXIT_ARGS, "bad_args", "Cada item de joints deve ter o formato {id: inteiro, direction: 1 ou -1}")
        rows.append({"id": row["id"], "direction": row["direction"]})
    imu = args.get("imu")
    if not isinstance(imu, dict):
        raise Stop(EXIT_ARGS, "bad_args", "imu deve ser um objeto")
    check_keys(imu, ("source", "quat"), "parâmetros de imu")
    if imu.get("source") not in IMU_SOURCES:
        raise Stop(EXIT_ARGS, "bad_args", "imu.source deve ser bus / bno08x / lsm6dsv16x")
    try:
        quat = normalize_quat(imu.get("quat"))
    except CalibError as e:
        raise Stop(EXIT_ARGS, "bad_args", f"imu.quat inválido: {e}") from e
    dry = args.get("dry_run", False)
    if not isinstance(dry, bool):
        raise Stop(EXIT_ARGS, "bad_args", "dry_run deve ser true ou false")
    return by, rows, {"source": imu["source"], "quat": quat}, dry


def read_calibration(op):
    try:
        with open(op.ctx.p(CALIB), "rb") as f:
            data = tomllib.load(f)
        st = os.stat(op.ctx.p(CALIB))
    except FileNotFoundError as e:
        raise Stop(EXIT_STATE, "no_calibration", f"Arquivo de calibração do programa principal não encontrado: {CALIB}", {"path": CALIB}) from e
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise Stop(EXIT_STATE, "bad_calibration", f"Não foi possível ler o arquivo de calibração do programa principal: {type(e).__name__}: {e}",
                   {"path": CALIB}) from e
    if not isinstance(data, dict):
        raise Stop(EXIT_STATE, "bad_calibration", "O nível superior do arquivo de calibração do programa principal não é um objeto", {"path": CALIB})
    return data, st


def _sha256(data):
    import hashlib
    return hashlib.sha256(data).hexdigest()


def file_meta(ctx, path):
    try:
        with open(ctx.p(path), "rb") as f:
            data = f.read()
        st = os.stat(ctx.p(path))
        return {"existed": True, "mode": stat.S_IMODE(st.st_mode), "uid": st.st_uid, "gid": st.st_gid,
                "size": len(data), "sha256": _sha256(data)}, data
    except FileNotFoundError:
        return {"existed": False}, None
    except OSError as e:
        raise Stop(EXIT_FAIL, "backup_failed", f"Não foi possível ler {path} durante o backup: {type(e).__name__}: {e}") from e


def calib_backup(op):
    """Um diretório por conjunto em calib-backups/<sequência>-<horário>/: arquivo principal, saved, commissioning (se existir) e manifest.
    A sequência é o maior valor existente +1, sem usar o relógio de parede (a placa não tem RTC). Mantém somente os 10 conjuntos mais recentes."""
    ensure_dir(op.ctx, CALIB_BACKUP_DIR, 0o700)
    try:
        names = os.listdir(op.ctx.p(CALIB_BACKUP_DIR))
    except OSError as e:
        raise Stop(EXIT_FAIL, "backup_failed", f"Não foi possível listar os backups anteriores: {type(e).__name__}: {e}") from e
    seq = 0
    for name in names:
        m = re.match(r"^(\d{4,})-", name)
        if m:
            seq = max(seq, int(m.group(1)))
    seq += 1
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    path = f"{CALIB_BACKUP_DIR}/{seq:04d}-{stamp}"
    ensure_dir(op.ctx, path, 0o700)
    specs = [(CALIB, "hd1910-calibration.toml"), (CALIB_SAVED, "hd1910-calibration.saved.toml"),
             (COMMISSIONING_DROPIN, "zzzz-zz-microduck-commissioning.conf")]
    files = []
    for src, name in specs:
        meta, data = file_meta(op.ctx, src)
        row = {"path": src, "name": name, **meta}
        if meta["existed"]:
            write_atomic(op.ctx, f"{path}/{name}", data, 0o600)
        files.append(row)
    manifest = {"version": VERSION, "created": stamp, "by": getattr(op, "by", None), "files": files}
    write_atomic(op.ctx, f"{path}/manifest.json",
                 (json.dumps(manifest, ensure_ascii=False, indent=1) + "\n").encode("utf-8"), 0o600)
    try:
        groups = sorted((n for n in os.listdir(op.ctx.p(CALIB_BACKUP_DIR))
                         if re.match(r"^\d{4,}-", n) and os.path.isdir(op.ctx.p(f"{CALIB_BACKUP_DIR}/{n}"))),
                        key=lambda n: int(n.split("-", 1)[0]))
        for old in groups[:-CALIB_BACKUPS_KEEP]:
            shutil.rmtree(op.ctx.p(f"{CALIB_BACKUP_DIR}/{old}"), ignore_errors=True)
    except OSError:
        pass
    op.emit("backup", "info", f"Backup dos arquivos anteriores à gravação criado: {path}", {"path": path, "keep": CALIB_BACKUPS_KEEP})
    return path


def _write_preserving(op, path, data, meta, default_mode):
    mode = int(meta.get("mode", default_mode)) if meta.get("existed") else default_mode
    uid = meta.get("uid") if meta.get("existed") else None
    gid = meta.get("gid") if meta.get("existed") else None
    write_atomic(op.ctx, path, data, mode, uid, gid)


def install_calibration(op, text, old, main_meta, saved_meta):
    """Mantém uma cópia do arquivo principal com extensão .previous; grava atomicamente o principal e o saved, preservando o proprietário e as permissões de cada um."""
    _write_preserving(op, CALIB_PREVIOUS, old, main_meta, 0o644)
    op.emit("write", "info", f"Cópia do arquivo anterior guardada em {CALIB_PREVIOUS}")
    payload = text.encode("utf-8")
    _write_preserving(op, CALIB, payload, main_meta, 0o644)
    _write_preserving(op, CALIB_SAVED, payload, saved_meta, int(main_meta.get("mode", 0o644)))
    op.emit("write", "info", f"Arquivos gravados: {CALIB} e {CALIB_SAVED}; proprietário e permissões preservados")


def _load_toml(op, path):
    try:
        with open(op.ctx.p(path), "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise Stop(EXIT_FAIL, "bad_toml", f"Não foi possível reler {path}: {type(e).__name__}: {e}") from e


def verify_calibration_file(op, data, source):
    for path in (CALIB, CALIB_SAVED):
        back = _load_toml(op, path)
        if not same_calibration(normalized_calibration(back), normalized_calibration(data)):
            raise Stop(EXIT_FAIL, "bad_toml", f"A leitura de retorno de {path} não corresponde aos dados gravados")
        validate_calibration(back, source)
    op.emit("check", "info", "Arquivos relidos e conferidos item a item: 15 servos, limites e orientação da IMU")


def robotd_hello(op):
    try:
        hello = op.ctx.rpc("hello", {"api_version": 40}, 1.0)
    except RpcError as e:
        return False, str(e)
    if not isinstance(hello, dict):
        return False, "hello não retornou um objeto"
    return True, hello


def wait_robotd(op, what="programa principal"):
    deadline = op.ctx.now() + CALIB_RESTART_WAIT
    last_emit = op.ctx.now()
    st = {}
    while op.ctx.now() < deadline:
        st = robotd_state(op)
        if st.get("ActiveState") == "active":
            ok, why = robotd_hello(op)
            if ok:
                op.emit("wait", "info", f"{what} iniciou e respondeu ao hello", {"robotd": st, "hello": why})
                return True, st
            st = dict(st, hello=why)
        if op.ctx.now() - last_emit >= 5.0:
            last_emit = op.ctx.now()
            op.emit("wait", "info", f"Aguardando {what} (ActiveState={st.get('ActiveState', '?')})", st)
        op.ctx.sleep(0.25)
    return False, st


def robotd_bus_status(op):
    try:
        st = op.ctx.rpc("robot.busStatus", {}, 1.0)
    except RpcError as e:
        return None, str(e)
    if not isinstance(st, dict):
        return None, "busStatus não retornou um objeto"
    return st, None


def calibration_status(op):
    try:
        r = op.ctx.rpc("robot.busCommand", {"action": "calibration-status"}, 2.0)
    except RpcError as e:
        return None, str(e)
    return (r, None) if isinstance(r, dict) else (None, "calibration-status não retornou um objeto")


def status_summary(st):
    st = st if isinstance(st, dict) else {}
    return {"mode": st.get("mode"), "phase": st.get("phase"), "error": st.get("error")}


def _num_same(a, b):
    return (isinstance(a, (int, float)) and not isinstance(a, bool)
            and isinstance(b, (int, float)) and not isinstance(b, bool)
            and math.isclose(float(a), float(b), rel_tol=0.0, abs_tol=1e-9))


def _same_field(a, b):
    if isinstance(a, float) or isinstance(b, float):
        return _num_same(a, b)
    return a == b


def readback_mismatches(expected, calibration):
    """Compara item a item a calibração de calibration_status(): sete campos das 15 articulações, motion_enabled,
    quat/verified da placa do barramento e cada entrada de imu_mounts. Tolerância para floats: 1e-9."""
    got = calibration if isinstance(calibration, dict) else {}
    exp = expected if isinstance(expected, dict) else {}
    out = []

    def one(label, a, b):
        if not _same_field(a, b):
            out.append(f"{label}: gravado {a!r}, leitura de retorno {b!r}")

    for key in ("motion_enabled", "imu_mount_verified", "imu_bus_protocol", "imu_bus_profile"):
        one(key, exp.get(key), got.get(key))
    one("imu_mount_quat", exp.get("imu_mount_quat"), got.get("imu_mount_quat"))
    ejs, gjs = exp.get("joints") if isinstance(exp.get("joints"), list) else [], got.get("joints") if isinstance(got.get("joints"), list) else []
    if len(ejs) != 15 or len(gjs) != 15:
        out.append(f"joints: {len(ejs)} gravadas, {len(gjs)} lidas de volta")
    for i in range(min(len(ejs), len(gjs))):
        e, g = ejs[i] if isinstance(ejs[i], dict) else {}, gjs[i] if isinstance(gjs[i], dict) else {}
        for field in ("name", "id", "zero_raw", "direction", "calibrated", "min_rad", "max_rad"):
            one(f"joints[{i}].{field}", e.get(field), g.get(field))
    em = exp.get("imu_mounts") if isinstance(exp.get("imu_mounts"), dict) else {}
    gm = got.get("imu_mounts") if isinstance(got.get("imu_mounts"), dict) else {}
    for kind in sorted(set(em) | set(gm)):
        e = em.get(kind) if isinstance(em.get(kind), dict) else {}
        g = gm.get(kind) if isinstance(gm.get(kind), dict) else {}
        one(f"imu_mounts.{kind}.quat", e.get("quat"), g.get("quat"))
        one(f"imu_mounts.{kind}.verified", e.get("verified"), g.get("verified"))
    return out


def wait_motion(op, expected):
    """Após reiniciar, verifica a cada 0,5 s por até 30 s. Sucesso = motion + control + calibração lida de volta idêntica item a item.
    Um erro de validação da calibração em waiting_for_bus falha imediatamente (inclusive em novas tentativas); outros erros (como falha ao abrir o barramento)
    podem ocorrer no início e o programa principal tenta novamente a cada segundo. Só falha se persistirem após 30 s. Retorna um dicionário de resultado que pode ser gravado em last-result."""
    deadline = op.ctx.now() + CALIB_MOTION_WAIT
    last, why = {}, None
    mismatches = []
    last_emit = op.ctx.now()
    while True:
        st, why = robotd_bus_status(op)
        if st is not None:
            last = st
        mode, phase, error = last.get("mode"), last.get("phase"), last.get("error")
        if phase == "waiting_for_bus" and error and CALIB_ERR.search(str(error)):
            return {"ok": False, "kind": "calib_rejected", "bus": last, "readback_ok": False,
                    "mismatches": [], "error": str(error)}
        if mode == "motion" and phase == "control":
            status, cs_err = calibration_status(op)
            if status is not None:
                mismatches = readback_mismatches(expected, status.get("calibration"))
                metadata_error = imu_bus_metadata(last)[2]
                if status.get("imu_source") in (None, "bus") and metadata_error:
                    mismatches.append(metadata_error)
                if not mismatches:
                    op.emit("wait", "info", "Programa principal entrou no modo de movimento; calibração relida corresponde a todos os valores",
                            {"busStatus": status_summary(last), "readback_ok": True})
                    return {"ok": True, "kind": "committed", "bus": last, "status": status,
                            "readback_ok": True, "mismatches": []}
                op.emit("wait", "warn", f"A calibração lida de volta diverge da gravada ({len(mismatches)} diferenças)",
                        {"mismatches": mismatches[:20]})
            else:
                op.emit("wait", "info", f"Entrou na fase de controle, mas a calibração ainda não foi lida: {cs_err}", {"busStatus": status_summary(last)})
        if op.ctx.now() >= deadline:
            break
        if op.ctx.now() - last_emit >= 5.0:
            last_emit = op.ctx.now()
            op.emit("wait", "info",
                    f"Aguardando o modo de movimento e a leitura da calibração pelo programa principal (mode={mode or '?'}; phase={phase or '?'})",
                    {"busStatus": status_summary(last), "mismatches": mismatches[:20]})
        op.ctx.sleep(CALIB_STATUS_INTERVAL)
    if not last and why:
        last = {"error": why}
    if mode == "motion" and phase == "control":
        kind = "readback_mismatch"
    elif phase == "waiting_for_bus" and last.get("error"):
        kind = "bus_unavailable"
    else:
        kind = "not_motion"
    return {"ok": False, "kind": kind, "bus": last, "readback_ok": False,
            "mismatches": mismatches, "error": last.get("error") or why}


def journal_tail(op):
    rc, out, err = op.ctx.run(["journalctl", "-u", "robotd", "-n", "30", "--no-pager"], timeout=5.0)
    lines = [line.rstrip() for line in (out or "").splitlines() if line.strip()]
    if not lines and err:
        lines = _stderr_lines(err)
    return lines[-30:]


def restart_robotd(op, what="Reiniciar o programa principal"):
    op.ctx.run(["systemctl", "reset-failed", "robotd"])
    rc, out, err = op.ctx.run(["systemctl", "restart", "robotd"], timeout=20.0)
    op.emit("restart", "info", what, {"rc": rc, "stderr": err.strip()[:300]})
    return rc == 0


def _restore_one(op, backup_dir, row, errors):
    path = row.get("path") if isinstance(row, dict) else None
    if not isinstance(path, str):
        errors.append("Uma entrada do manifest não contém path")
        return False
    try:
        if row.get("existed"):
            name = row.get("name")
            with open(op.ctx.p(f"{backup_dir}/{name}"), "rb") as f:
                data = f.read()
            if _sha256(data) != row.get("sha256"):
                raise OSError(f"O SHA-256 do arquivo de backup {name} está incorreto")
            _write_preserving(op, path, data, row, 0o644)
        elif exists(op.ctx, path):
            remove(op.ctx, path)
        return True
    except (OSError, Stop) as e:
        errors.append(f"{path}: {type(e).__name__}: {e}")
        return False


def rollback(op, backup_path):
    """Restaura separadamente os arquivos principal, saved e commissioning do backup e relata falhas na restauração."""
    out = {"files_restored": False, "mode_restored": False, "robotd_up_after_rollback": False,
           "errors": [], "backup": backup_path}
    try:
        with open(op.ctx.p(f"{backup_path}/manifest.json"), encoding="utf-8") as f:
            manifest = json.load(f)
        rows = manifest.get("files") if isinstance(manifest, dict) else None
        if not isinstance(rows, list):
            raise ValueError("O manifest não contém files")
    except (OSError, ValueError) as e:
        out["errors"].append(f"Não foi possível ler o manifest do backup: {type(e).__name__}: {e}")
        return out
    by_path = {r.get("path"): r for r in rows if isinstance(r, dict)}
    ok = True
    for path in (CALIB, CALIB_SAVED):
        ok = _restore_one(op, backup_path, by_path.get(path) or {"path": path, "existed": False}, out["errors"]) and ok
    crow = by_path.get(COMMISSIONING_DROPIN) or {"path": COMMISSIONING_DROPIN, "existed": False}
    mode_ok = _restore_one(op, backup_path, crow, out["errors"])
    out["files_restored"] = bool(ok)                    # Considera somente .toml / .saved.toml; o modo é informado separadamente.
    out["mode_restored"] = bool(mode_ok and exists(op.ctx, COMMISSIONING_DROPIN) == bool(crow.get("existed")))
    op.ctx.run(["systemctl", "daemon-reload"])
    op.emit("rollback", "warn", "Arquivos de calibração e modo restaurados ao estado anterior à gravação", out)
    restart_robotd(op, "Reiniciar o programa principal com os arquivos originais")
    up, rst = wait_robotd(op, "programa principal após a restauração")
    out["robotd_up_after_rollback"] = bool(up)
    out["robotd"] = rst
    if not up:
        out["errors"].append("O programa principal não respondeu ao hello em até 40 segundos após a restauração")
    op.emit("rollback", "info" if up else "error",
            "O programa principal iniciou após a restauração" if up else "O programa principal não iniciou após a restauração; exporte o pacote de diagnóstico na página de registros",
            {"robotd_up_after_rollback": up})
    return out


def _rollback_words(rb):
    if not isinstance(rb, dict):
        return "; não foi possível determinar o resultado da restauração; exporte o pacote de diagnóstico na página de registros"
    if rb.get("files_restored") and rb.get("mode_restored") and rb.get("robotd_up_after_rollback"):
        return "; arquivos e modo originais restaurados e programa principal reiniciado"
    bits = []
    if not rb.get("files_restored"):
        bits.append("nem todos os arquivos foram restaurados")
    if not rb.get("mode_restored"):
        bits.append("o modo de calibração/movimento não foi restaurado")
    if not rb.get("robotd_up_after_rollback"):
        bits.append("o programa principal não iniciou após a restauração")
    return "; restauração incompleta (" + ", ".join(bits) + "); exporte o pacote de diagnóstico na página de registros"


def _commit_detail(base, judged, rb=None, journal=None):
    d = dict(base)
    d["bus_status"] = status_summary((judged or {}).get("bus"))
    d["readback_ok"] = bool((judged or {}).get("readback_ok"))
    d["mismatches"] = list((judged or {}).get("mismatches") or [])
    if journal is not None:
        d["journal"] = journal
    if rb is not None:
        d["rolled_back"] = bool(rb.get("files_restored") and rb.get("mode_restored")
                                and rb.get("robotd_up_after_rollback"))
        d["files_restored"] = bool(rb.get("files_restored"))
        d["mode_restored"] = bool(rb.get("mode_restored"))
        d["robotd_up_after_rollback"] = bool(rb.get("robotd_up_after_rollback"))
        d["rollback"] = rb
    return d


def _commit_fail(op, kind, why, base, judged, journal):
    rb = rollback(op, base["backup"])
    detail = _commit_detail(base, judged, rb, journal)
    return op.finish(EXIT_FAIL, kind, why + _rollback_words(rb), detail)


def verb_calib_read(op, args):
    op.by = check_calib_read_args(args)
    data, st = read_calibration(op)
    mode, text = calib_mode(op, strict=False)
    detail = {"calibration": data, "mode": mode, "commissioning_file": COMMISSIONING_DROPIN,
              "commissioning_present": exists(op.ctx, COMMISSIONING_DROPIN),
              "exec_has_commissioning": "--commissioning" in exec_start(op), "path": CALIB,
              "mode_text": text, "mode_bits": stat.S_IMODE(st.st_mode)}
    return op.finish(EXIT_OK, "read", f"Arquivo de calibração lido: {mode} ({text})", detail, record=False)


def verb_calib_commit(op, args, raw):
    by, joints, imu, dry = check_calib_commit_args(args)
    op.by = by
    if not dry and op.ctx.env.get(DETACH_ENV) != "1":
        return detach(op, raw, "calib-commit")
    # Adquire o bloqueio antes de verificar a sinalização; compartilha helper.lock com bus-take / bus-give-back.
    op.take_lock("gravar calibração")
    imu_redo_conflict(op)
    if flag_present(op.ctx):
        raise Stop(EXIT_STATE, "bus_held", "A página dos servos está usando o barramento; clique em “Devolver ao programa principal” antes de gravar")
    op.emit("bus", "info", "A página dos servos não está usando o barramento; gravação permitida")
    mode, mode_text = calib_mode(op)
    op.emit("mode", "info", mode_text, {"mode": mode, "commissioning_file": COMMISSIONING_DROPIN})
    why = calib_gate(op, mode)
    data, st = read_calibration(op)
    rows = data.get("joints") if isinstance(data.get("joints"), list) else []
    if imu["source"] == "bus":
        live, err = robotd_bus_status(op)
        info, configured, metadata_error = imu_bus_metadata(live)
        if metadata_error:
            raise Stop(EXIT_STATE, "readback_mismatch", metadata_error)
        if configured is not None or data.get("imu_bus_profile") == "qinmo":
            if (not isinstance(info, dict) or info.get("profile", "legacy") != data.get("imu_bus_profile", "legacy")
                    or configured != info.get("profile", "legacy")
                    or info.get("protocol") != data.get("imu_bus_protocol", "feetech")):
                raise Stop(EXIT_STATE, "readback_mismatch", "O tipo da IMU no barramento não corresponde à orientação verificada; calibre novamente na página da IMU")
            status, err = calibration_status(op)
            top = (status or {}).get("imu_mount")
            if (status is None or imu_redo_source(live, status) != "bus"
                    or (configured == "qinmo" and (data.get("imu_mount_verified") is not True
                        or (isinstance(top, dict) and top.get("verified") is not True)))):
                raise Stop(EXIT_STATE, "readback_mismatch", "A orientação de instalação da Qinmo ainda não foi verificada pelo programa principal; não é possível ignorar esta etapa")
    file_ids = {r.get("id") for r in rows if isinstance(r, dict)}
    given = {r["id"] for r in joints}
    if file_ids != given:
        raise Stop(EXIT_STATE, "joint_mismatch",
                   f"Os 15 IDs informados ({sorted(given)}) não correspondem aos do arquivo do programa principal ({sorted(file_ids, key=str)})",
                   {"file_ids": sorted(file_ids, key=str), "given": sorted(given)})
    op.emit("read", "info", f"Calibração do programa principal lida: {len(rows)} servos; os IDs correspondem")

    try:
        built = build_calibration(data, joints, imu)
        validate_calibration(built, imu["source"])
    except CalibError as e:
        raise Stop(EXIT_ARGS, "invalid", f"O conteúdo a gravar não passou na validação: {e}") from e
    op.emit("build", "info", "Novos dados montados com limites padrão e as orientações informadas para os servos e a IMU")
    text = render_calibration(built)
    back = tomllib.loads(text)
    if not same_calibration(normalized_calibration(back), normalized_calibration(built)):
        raise Stop(EXIT_FAIL, "bad_toml", "O TOML gerado não corresponde aos dados que serão gravados")
    validate_calibration(back, imu["source"])
    op.emit("check", "info", "Validação concluída antes da gravação: 15 servos, limites e orientação da IMU válidos")

    if dry:
        return op.finish(EXIT_OK, "preview", "Prévia pronta: nenhum arquivo foi gravado e nenhum serviço foi reiniciado",
                         {"toml": text, "by": by, "source": imu["source"], "dry_run": True,
                          "mode": mode, "gate": why})

    backup_path = calib_backup(op)
    with open(op.ctx.p(f"{backup_path}/manifest.json"), encoding="utf-8") as f:
        manifest = json.load(f)
    metas = {r.get("path"): r for r in manifest.get("files") or [] if isinstance(r, dict)}
    main_meta = metas.get(CALIB) or {"existed": True, "mode": stat.S_IMODE(st.st_mode),
                                     "uid": st.st_uid, "gid": st.st_gid}
    saved_meta = metas.get(CALIB_SAVED) or {"existed": False}
    try:
        with open(op.ctx.p(CALIB), "rb") as f:
            old = f.read()
    except OSError as e:
        raise Stop(EXIT_FAIL, "read_failed", f"Não foi possível ler o arquivo atual antes da gravação: {type(e).__name__}: {e}") from e
    base = {"by": by, "backup": backup_path, "toml": text, "source": imu["source"],
            "mode_before": mode, "mode_text": mode_text, "gate": why}
    journal = []
    judged = None
    try:
        install_calibration(op, text, old, main_meta, saved_meta)
        verify_calibration_file(op, built, imu["source"])
        if mode == "commissioning":
            if not remove(op.ctx, COMMISSIONING_DROPIN):
                raise OSError(f"O arquivo commissioning não foi encontrado: {COMMISSIONING_DROPIN}")
            op.ctx.run(["systemctl", "daemon-reload"])
            op.emit("mode", "info", "Arquivo drop-in do modo de calibração removido; o programa principal iniciará no modo de movimento")
        restart_robotd(op)
        up, rst = wait_robotd(op)
        base["robotd"] = rst
        journal = journal_tail(op)
        if not up:
            return _commit_fail(op, "restart_failed", "Os dados foram gravados, mas o programa principal não iniciou em até 40 segundos (sem resposta ao hello)",
                                base, {"bus": None, "readback_ok": False, "mismatches": []}, journal)
        judged = wait_motion(op, built)
        if judged.get("ok"):
            detail = _commit_detail(base, judged, None, journal)
            return op.finish(EXIT_OK, "committed",
                             "Calibração gravada: o programa principal entrou no modo de movimento e os 15 servos e a orientação da IMU foram lidos corretamente", detail)
        bus = status_summary(judged.get("bus"))
        if judged.get("kind") == "calib_rejected":
            why = f"A calibração foi rejeitada pelo programa principal: {judged.get('error')}"
        elif judged.get("kind") == "bus_unavailable":
            why = f"O programa principal não conseguiu abrir o barramento dos servos: {judged.get('error')}. A alimentação dos servos está ligada?"
        elif judged.get("kind") == "readback_mismatch":
            first = (judged.get("mismatches") or ["calibration-status não foi lido"])[0]
            why = f"O programa principal entrou no modo de movimento, mas a calibração lida difere dos dados gravados: {first}"
        else:
            stuck = bus.get("error") or f"mode={bus.get('mode') or '?'},phase={bus.get('phase') or '?'}"
            why = f"O programa principal não entrou no modo de movimento após 30 segundos: {stuck}"
        return _commit_fail(op, judged.get("kind") or "not_motion", why, base, judged, journal)
    except Stop as e:
        rb = rollback(op, backup_path)
        detail = _commit_detail(base, judged, rb, journal_tail(op))
        if isinstance(e.detail, dict):
            detail.update({k: v for k, v in e.detail.items() if k not in detail})
        reason = f"Ocorreu um erro durante a gravação: {e.reason}" + _rollback_words(rb)
        return op.finish(EXIT_FAIL, e.result, reason, detail)
    except Exception as e:  # noqa: BLE001 — qualquer exceção após o início da gravação aciona a restauração
        rb = rollback(op, backup_path)
        detail = _commit_detail(base, judged, rb, journal_tail(op))
        reason = f"Ocorreu um erro durante a gravação: {type(e).__name__}: {e}" + _rollback_words(rb)
        return op.finish(EXIT_FAIL, "write_failed", reason, detail)


# ---------------------------------------------------------------------------
# Repeat initial IMU calibration. This transaction never builds a joint calibration.

def imu_redo_file(op, path):
    """Only root-owned regular files; never follow a caller's symlink."""
    st = os.lstat(op.ctx.p(path))
    if not stat.S_ISREG(st.st_mode) or (op.ctx.check_owner and (st.st_uid != 0 or st.st_mode & 0o022)):
        raise Stop(EXIT_STATE, "imu_session_tampered", f"Arquivo da sessão da IMU inseguro:{path}")
    with open(op.ctx.p(path), "rb") as stream:
        return stream.read()


def imu_redo_arguments(description):
    # systemctl's ExecStart has one record, with an explicitly direct robotd executable.
    match = re.fullmatch(r"\{\s*path=([^;{}]+?)\s*;\s*argv\[\]=([^{}]*?)\s*;\s*(?:ignore_errors=[^{}]*?)?\}",
                         description.strip(), re.S)
    if not match:
        raise Stop(EXIT_STATE, "unsupported_exec", "Não foi possível determinar o único comando de inicialização efetivo do programa principal; o serviço não foi alterado")
    if re.search(r"\\(?:x[0-9a-fA-F]{2}|[0-7]{3}|[nrt])|[$%]", match.group(2)):
        raise Stop(EXIT_STATE, "unsupported_exec", "Os parâmetros de inicialização contêm escapes ou expansões de ambiente ambíguos; o serviço não foi alterado")
    try:
        argv = shlex.split(match.group(2))
    except ValueError as err:
        raise Stop(EXIT_STATE, "unsupported_exec", "Os parâmetros de inicialização do programa principal são ambíguos; o serviço não foi alterado") from err
    path = match.group(1).strip()
    if (not argv or argv[0] != path or not path.startswith("/") or path.rsplit("/", 1)[-1] != "robotd"
            or any(any(c in a for c in "\n\r\0") for a in argv)):
        raise Stop(EXIT_STATE, "unsupported_exec", "O programa principal usa um comando wrapper ou parâmetros ambíguos; o serviço não foi alterado")
    return argv


def imu_redo_quote(argument):
    return '"' + argument.replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%').replace('$', '$$') + '"'


def imu_redo_override(manifest):
    return ("# Owned by microduck-helper imu-recalibrate: " + manifest["session_id"] +
            "\n[Service]\nExecStart=\nExecStart=" +
            " ".join(imu_redo_quote(a) for a in manifest["exec_args"] + ["--commissioning"]) + "\n").encode()


def imu_redo_load(op):
    if not exists(op.ctx, IMU_REDO_MANIFEST):
        return None
    try:
        # Check each enclosing persistent directory, including when this is a resumed session.
        for path in (OPLOG_DIR, IMU_REDO_DIR):
            st = os.lstat(op.ctx.p(path))
            if not stat.S_ISDIR(st.st_mode) or (op.ctx.check_owner and (st.st_uid != 0 or st.st_mode & 0o022)):
                raise ValueError("Diretório da sessão inseguro")
        m = json.loads(imu_redo_file(op, IMU_REDO_MANIFEST))
        if (m.get("schema") != IMU_REDO_SCHEMA or type(m.get("active")) is not bool
                or not re.fullmatch(r"[0-9a-f]{32}", m.get("session_id", ""))
                or m.get("source") not in IMU_SOURCES or not isinstance(m.get("exec_args"), list)
                or not all(isinstance(a, str) for a in m["exec_args"])
                or not m["exec_args"] or "--commissioning" in m["exec_args"]):
            raise ValueError("Formato inválido do manifest")
        expected_paths = (CALIB, CALIB_SAVED)
        if (not isinstance(m.get("files"), list) or len(m["files"]) != 2
                or tuple(row.get("path") for row in m["files"]) != expected_paths
                or tuple(row.get("name") for row in m["files"]) != ("main.toml", "saved.toml")):
            raise ValueError("Formato inválido do manifesto de backup")
        if m.get("override_sha256") != _sha256(imu_redo_override(m)):
            raise ValueError("Resumo do arquivo de modo inválido")
        if "profile" in m:
            if (m["profile"] not in ("legacy", "qinmo") or m.get("original_mode") not in ("motion", "commissioning", "startup")
                    or tuple(row.get("path") for row in m.get("config_files", [])) != (IMU_CONFIG, IMU_CONFIG_SAVED)
                    or tuple(row.get("name") for row in m.get("config_files", [])) != ("config.toml", "config-saved.toml")):
                raise ValueError("Formato inválido do manifesto de backup do tipo")
        if m["active"]:
            directory = IMU_REDO_DIR + "/" + m["session_id"]
            st = os.lstat(op.ctx.p(directory))
            if not stat.S_ISDIR(st.st_mode) or (op.ctx.check_owner and (st.st_uid != 0 or st.st_mode & 0o022)):
                raise ValueError("Diretório de backup inseguro")
            for row in m["files"] + m.get("config_files", []):
                if row.get("existed") and _sha256(imu_redo_file(op, directory + "/" + row["name"])) != row.get("sha256"):
                    raise ValueError("Resumo do backup inválido")
            raw = imu_redo_file(op, directory + "/calibration.json")
            if _sha256(raw) != m.get("calibration_sha256"):
                raise ValueError("Resumo do instantâneo de calibração inválido")
        return m
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as err:
        raise Stop(EXIT_STATE, "imu_session_tampered", f"Não foi possível reler a sessão da IMU ou ela foi alterada:{err}；o estado atual foi preservado") from err


def imu_redo_conflict(op):
    m = imu_redo_load(op)
    if (m and m["active"]) or exists(op.ctx, IMU_REDO_DROPIN):
        raise Stop(EXIT_STATE, "imu_recalibrate_active", "A recalibração inicial da IMU está em andamento; conclua ou cancele antes de operar os servos ou gravar a calibração completa")


def imu_redo_save(op, manifest, phase, **fields):
    manifest.update(phase=phase, **fields)
    write_atomic(op.ctx, IMU_REDO_MANIFEST, (json.dumps(manifest, ensure_ascii=False, indent=1) + "\n").encode(), 0o644)


def imu_redo_source(bus, status):
    native = bus.get("native") if isinstance(bus.get("native"), dict) else {}
    sample = (bus.get("last_sample") or {}).get("imu") or {}
    source = native.get("imu_source") or sample.get("source") or status.get("imu_source")
    if source not in IMU_SOURCES or status.get("imu_source") != source:
        raise Stop(EXIT_STATE, "imu_source_changed", "A fonte atual da IMU diverge na leitura de retorno; interrompa a recalibração")
    return source


def imu_redo_same(a, b):
    if isinstance(a, dict) and isinstance(b, dict):
        return set(a) == set(b) and all(imu_redo_same(a[k], b[k]) for k in a)
    if isinstance(a, list) and isinstance(b, list):
        return len(a) == len(b) and all(imu_redo_same(x, y) for x, y in zip(a, b))
    if isinstance(a, bool) or isinstance(b, bool):
        return a is b
    if isinstance(a, (float, int)) and isinstance(b, (float, int)):
        return _num_same(a, b)
    return a == b


def imu_redo_gate(op, mode, source=None):
    """Require two fresh, confirmed off snapshots; unknown is not torque-off."""
    for i in range(2):
        if i:
            op.ctx.sleep(GATE_GAP)
        bus, err = robotd_bus_status(op)
        if bus is None:
            raise Stop(EXIT_STATE, "refused", f"Não foi possível reler o estado do programa principal:{err}")
        native = bus.get("native") if isinstance(bus.get("native"), dict) else {}
        hd = native.get("hd1910") if isinstance(native.get("hd1910"), dict) else {}
        safe = bus.get("mode") == mode and bus.get("torque_off_pending") is not True and not bus.get("home_recovery")
        if mode == "motion":
            safe = (safe and bus.get("phase") == "control" and bus.get("policy_enabled") is False
                    and native.get("torque_state_confirmed") is False
                    and hd.get("restore_pending") is False and hd.get("temporary_gains_applied") is False)
        else:
            safe = (safe and bus.get("phase") in COMMISSIONING_UP and bus.get("torque_state") == "off"
                    and not bus.get("motion") and not (bus.get("hold") or {}).get("active")
                    and bus.get("policy_motion_enabled") is not True)
        if not safe:
            raise Stop(EXIT_STATE, "refused", "Estabilize o Microduck e alivie a carga. Aguarde o programa principal confirmar que todos os servos estão desabilitados e os ganhos temporários foram restaurados antes de repetir a calibração inicial da IMU")
        if source is not None:
            status, err = calibration_status(op)
            if status is None or imu_redo_source(bus, status) != source:
                raise Stop(EXIT_STATE, "imu_source_changed", "A fonte da IMU mudou ou não pôde ser relida; interrompa a recalibração")
    return bus


def imu_redo_readback(op, expected, source, quat=None):
    bus, err = robotd_bus_status(op)
    status, cs_err = calibration_status(op)
    if bus is None or status is None or imu_redo_source(bus, status) != source:
        raise Stop(EXIT_STATE, "readback_mismatch", f"Não foi possível reler a fonte atual da IMU:{err or cs_err or source}")
    cal = status.get("calibration")
    if not imu_redo_same(normalized_calibration(expected), normalized_calibration(cal or {})):
        raise Stop(EXIT_STATE, "readback_mismatch", "A calibração lida do programa principal diverge do arquivo item a item; a sessão foi preservada")
    info, configured, metadata_error = imu_bus_metadata(bus)
    if source == "bus" and metadata_error:
        raise Stop(EXIT_STATE, "readback_mismatch", metadata_error)
    if quat is not None:
        if (source == "bus" and isinstance(info, dict)
                and (info.get("protocol") != cal.get("imu_bus_protocol", "feetech")
                     or info.get("profile", "legacy") != cal.get("imu_bus_profile", "legacy")
                     or info.get("profile", "legacy") not in ("legacy", "qinmo"))):
            raise Stop(EXIT_STATE, "readback_mismatch", "O protocolo/tipo da IMU atual no barramento não corresponde à calibração de orientação de instalação verificada")
        if source == "bus" and imu_profile_configured(bus) is not None and not isinstance(info, dict):
            raise Stop(EXIT_STATE, "readback_mismatch", "A IMU atual do barramento ainda não está conectada; não é possível confirmar a orientação de instalação")
        mount = ({"quat": cal.get("imu_mount_quat"), "verified": cal.get("imu_mount_verified")}
                 if source == "bus" else (cal.get("imu_mounts") or {}).get(source) or {})
        top = status.get("imu_mount")
        if mount.get("verified") is not True or not imu_redo_same(mount.get("quat"), quat):
            raise Stop(EXIT_STATE, "readback_mismatch", "A nova orientação/verified da IMU não foi confirmada item a item na leitura de retorno")
        if isinstance(top, dict) and (top.get("verified") is not True or not imu_redo_same(top.get("quat"), quat)):
            raise Stop(EXIT_STATE, "readback_mismatch", "A orientação atual da IMU efetiva no programa principal diverge")
    return status


def imu_redo_owned(op, m, allow_missing=False):
    if not exists(op.ctx, IMU_REDO_DROPIN):
        if allow_missing:
            # A killed helper may have unlinked its override either before or
            # after daemon-reload. Both loaded commands are pinned known forms;
            # neither tells us which mode the still-running process is using.
            loaded = imu_redo_arguments(exec_start(op))
            if loaded not in (m["exec_args"], m["exec_args"] + ["--commissioning"]):
                raise Stop(EXIT_STATE, "imu_session_tampered", "Os parâmetros efetivos de inicialização do programa principal mudaram durante a interrupção da sessão; o estado atual foi preservado")
            return
        raise Stop(EXIT_STATE, "imu_session_tampered", "O arquivo de modo da sessão da IMU desapareceu; o estado atual foi preservado")
    if imu_redo_file(op, IMU_REDO_DROPIN) != imu_redo_override(m):
        raise Stop(EXIT_STATE, "imu_session_tampered", "O arquivo de modo da sessão da IMU foi alterado; o conteúdo de terceiros não será removido")
    loaded = imu_redo_arguments(exec_start(op))
    if (loaded != m["exec_args"] + ["--commissioning"]
            and not (allow_missing and loaded == m["exec_args"])):
        raise Stop(EXIT_STATE, "imu_session_tampered", "Os parâmetros efetivos de inicialização do programa principal foram alterados; o estado atual foi preservado")


def imu_redo_restart(op, mode, expected, source):
    if not restart_robotd(op) or not wait_robotd(op)[0]:
        raise Stop(EXIT_FAIL, "restart_failed", "Falha ao reiniciar o programa principal; a sessão foi preservada e pode ser repetida ou cancelada")
    deadline = op.ctx.now() + CALIB_MOTION_WAIT
    while True:
        bus, _ = robotd_bus_status(op)
        if bus and bus.get("mode") == mode and bus.get("phase") == ("control" if mode == "motion" else "ready"):
            break
        if op.ctx.now() >= deadline:
            raise Stop(EXIT_FAIL, "restart_failed", "O programa principal ainda não voltou ao modo esperado; a sessão foi preservada")
        op.ctx.sleep(CALIB_STATUS_INTERVAL)
    # Motion startup may need a bounded relax to confirm the torque readback.
    if mode == "motion" and (bus.get("native") or {}).get("torque_state_confirmed") is not False:
        op.ctx.rpc("robot.relax", {}, 3.0)
    imu_redo_gate(op, mode, source)
    return imu_redo_readback(op, expected, source)


def imu_redo_restore_original(op, m):
    if "profile" in m:
        return imu_profile_restore(op, m)
    errors = []
    directory = IMU_REDO_DIR + "/" + m["session_id"]
    for row in m["files"]:
        if not _restore_one(op, directory, row, errors):
            raise Stop(EXIT_FAIL, "rollback_failed", "; ".join(errors))
    imu_redo_owned(op, m, allow_missing=True)
    remove(op.ctx, IMU_REDO_DROPIN)
    if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0 or imu_redo_arguments(exec_start(op)) != m["exec_args"]:
        raise Stop(EXIT_FAIL, "rollback_failed", "Os parâmetros de inicialização originais não foram restaurados; a sessão foi preservada")
    expected = _load_toml(op, CALIB)
    status = imu_redo_restart(op, "motion", expected, m["source"])
    pads_restore(op, m["controllers"])
    imu_redo_save(op, m, "cancelled", active=False)
    return status


def imu_bus_metadata(bus):
    """Validate raw presence before projection; mirrored in the standalone helper."""
    bus = bus if isinstance(bus, dict) else {}
    native = bus.get("native") if isinstance(bus.get("native"), dict) else {}
    infos = [part["imu_bus"] for part in (native, bus) if "imu_bus" in part]
    profiles = [part["configured_imu_profile"] for part in (native, bus) if "configured_imu_profile" in part]
    error = None
    for info in infos:
        if (not isinstance(info, dict) or info.get("protocol") not in ("feetech", "dxl2")
                or info.get("profile", "legacy") not in ("legacy", "qinmo")
                or (info.get("profile") == "qinmo" and info.get("protocol") != "feetech")):
            error = "O programa principal informou um protocolo/tipo de IMU incompatível ou divergente; é necessária confirmação e não é possível usar a orientação antiga nem continuar a calibração"
    if any(profile not in ("legacy", "qinmo") for profile in profiles):
        error = "O programa principal informou um protocolo/tipo de IMU incompatível ou divergente; é necessária confirmação e não é possível usar a orientação antiga nem continuar a calibração"
    if not error:
        bindings = [(info["protocol"], info.get("profile", "legacy")) for info in infos]
        if (any(binding != bindings[0] for binding in bindings[1:])
                or any(profile != profiles[0] for profile in profiles[1:])
                or (bindings and profiles and bindings[0][1] != profiles[0])):
            error = "O programa principal informou um protocolo/tipo de IMU incompatível ou divergente; é necessária confirmação e não é possível usar a orientação antiga nem continuar a calibração"
    return (infos[0] if infos and isinstance(infos[0], dict) else None,
            profiles[0] if profiles else None, error)

def imu_profile_configured(bus):
    return imu_bus_metadata(bus)[1]


def imu_profile_controllers_stop(op):
    pads_stop(op)
    # R3 listening can remain latched after padd stops and issue direct sit/stand.
    # Pin this one known service; no caller-supplied service names are accepted.
    if is_active(op, "duck-echo"):
        op.ctx.run(["systemctl", "stop", "duck-echo"])
    if any(is_active(op, unit) for unit in ("padd", GAMESIR, "duck-echo")):
        raise Stop(EXIT_STATE, "refused", "Os serviços de controle por controle remoto/voz não foram interrompidos; o tipo não foi alterado")


def imu_profile_controllers_restore(op, was):
    pads_restore(op, was)
    if was.get("duck_echo"):
        op.ctx.run(["systemctl", "start", "--no-block", "duck-echo"])


def imu_profile_safe_file(op, path):
    # Check every ancestor: lstat on the leaf alone still follows a symlinked parent.
    parts = path.strip("/").split("/")
    for index in range(1, len(parts)):
        st = os.lstat(op.ctx.p("/" + "/".join(parts[:index])))
        if not stat.S_ISDIR(st.st_mode) or (op.ctx.check_owner and (st.st_uid != 0 or st.st_mode & 0o022)):
            raise Stop(EXIT_STATE, "unsafe_config", "O proprietário/permissões do diretório de configuração do programa principal não são seguros; nada foi alterado")
    return imu_redo_file(op, path)


def imu_profile_config(op, argv):
    values = [argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg == "--params"]
    sockets = [argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg == "--socket"]
    if (values != [IMU_CONFIG] or sockets != [SOCK]
            or any(a.startswith(("--params=", "--socket=")) or a in ("--read-only", "--config", "--fake") for a in argv)):
        raise Stop(EXIT_STATE, "unsupported_config", "O programa principal não usa um caminho de configuração fixo compatível; nada foi alterado")
    dropins = show(op, "robotd", ["DropInPaths"]).get("DropInPaths", "").split()
    allowed = {"/etc/systemd/system/robotd.service.d/zzzz-r17-0151.conf",
               "/etc/systemd/system/robotd.service.d/zzzz-studio-bus.conf", COMMISSIONING_DROPIN, IMU_REDO_DROPIN}
    if not dropins or set(dropins) - allowed:
        raise Stop(EXIT_STATE, "unsupported_exec", "Há uma substituição de serviço não compatível para o programa principal; nada foi alterado")
    # The executable and its ancestors are also pinned to safe root-owned files.
    if op.ctx.check_owner:
        imu_profile_safe_file(op, argv[0])
    result = []
    for path in (IMU_CONFIG, IMU_CONFIG_SAVED):
        raw = imu_profile_safe_file(op, path)
        try:
            data = tomllib.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeError) as err:
            raise Stop(EXIT_STATE, "bad_toml", "Não foi possível reler a configuração do programa principal; nada foi alterado") from err
        bus = data.get("bus") or {}
        if (bus.get("protocol") != "feetech" or bus.get("imu_protocol", "auto") not in ("auto", "feetech", "dxl2")
                or bus.get("imu_profile", "legacy") not in ("legacy", "qinmo")
                or (data.get("trunk_imu") or {}).get("source", "bus") != "bus"
                or data.get("feetech_calibration") != CALIB):
            raise Stop(EXIT_STATE, "unsupported_config", "A seleção de tipo aceita somente IMUs no barramento de servos Feetech; a configuração atual não corresponde")
        result.append((path, raw, data))
    return result


def imu_profile_text(raw, profile):
    """Patch only two scalar keys, including the image's quoted TOML spelling.

    Parsing before and after is authoritative. Ambiguous syntax is refused rather
    than reserializing policy tables or making a general configuration editor.
    """
    import copy
    text = raw.decode("utf-8")
    data = tomllib.loads(text)
    expected = copy.deepcopy(data)
    expected["bus"].update(imu_profile=profile, imu_protocol="feetech" if profile == "qinmo" else "auto")
    lines = text.splitlines(keepends=True)
    headers = [i for i, line in enumerate(lines) if re.fullmatch(r'\s*\[\s*(?:bus|"bus"|\x27bus\x27)\s*\]\s*(?:#[^\n]*)?\n?', line)]
    if len(headers) != 1:
        raise Stop(EXIT_STATE, "bad_toml", "A seção bus não tem uma única forma de escrita compatível; nada foi alterado")
    start = headers[0] + 1
    end = next((i for i in range(start, len(lines)) if re.match(r"\s*\[", lines[i])), len(lines))
    block = lines[start:end]
    for key in ("imu_profile", "imu_protocol"):
        pattern = re.compile(r'\s*(?:' + key + '|"' + key + '"|\x27' + key + r'\x27)\s*=')
        matches = [i for i, line in enumerate(block) if pattern.match(line)]
        replacement = key + ' = "' + expected["bus"][key] + '"\n'
        if len(matches) > 1:
            raise Stop(EXIT_STATE, "bad_toml", "O campo de tipo está duplicado; nada foi alterado")
        if matches:
            block[matches[0]] = replacement
        else:
            block.insert(0, replacement)
    if start and not lines[start-1].endswith("\n"):
        lines[start-1] += "\n"
    result = "".join(lines[:start] + block + lines[end:]).encode()
    if not imu_redo_same(tomllib.loads(result.decode()), expected):
        raise Stop(EXIT_STATE, "bad_toml", "A alteração do tipo modificaria outras configurações; nada foi alterado")
    return result


def imu_profile_unverify(raw):
    import copy
    data = tomllib.loads(raw.decode("utf-8"))
    expected = copy.deepcopy(data)
    expected["imu_mount_verified"] = False
    text, count = re.subn(r'(?m)^\s*(?:imu_mount_verified|"imu_mount_verified"|\x27imu_mount_verified\x27)\s*=\s*(?:true|false)\s*(?:#[^\n]*)?$',
                          'imu_mount_verified = false', raw.decode("utf-8"))
    if count != 1 or not imu_redo_same(tomllib.loads(text), expected):
        raise Stop(EXIT_STATE, "bad_toml", "O campo de confirmação da orientação de instalação não tem uma forma de escrita segura e única; nada foi alterado")
    return text.encode()


def imu_profile_gate(op):
    """Control uses the existing strict gate; pre-control proves lifecycle only."""
    for index in range(2):
        if index:
            op.ctx.sleep(GATE_GAP)
        bus, err = robotd_bus_status(op)
        info, profile, metadata_error = imu_bus_metadata(bus)
        if metadata_error:
            raise Stop(EXIT_STATE, "unsupported_daemon", metadata_error)
        if profile not in ("legacy", "qinmo"):
            raise Stop(EXIT_STATE, "unsupported_daemon", "Esta versão do programa principal ainda não permite selecionar o tipo de IMU pela interface web; solicite primeiro uma atualização aos mantenedores")
        mode, phase = bus.get("mode"), bus.get("phase")
        if mode == "motion" and phase == "control":
            imu_redo_gate(op, "motion")
        elif (mode in ("motion", "commissioning") and phase in ("configuring_bus", "waiting_for_bus")
              and not bus.get("policy_enabled") and not bus.get("policy_motion_enabled")
              and not bus.get("motion") and not bus.get("home_recovery") and not bus.get("hold")):
            if not running(robotd_state(op)):
                raise Stop(EXIT_STATE, "refused", "Não foi possível confirmar o estado de inicialização do programa principal; nada foi alterado")
        elif mode == "commissioning" and phase in COMMISSIONING_UP:
            imu_redo_gate(op, "commissioning")
        else:
            raise Stop(EXIT_STATE, "refused", "O programa principal está em estado desconhecido/ativo; estabilize o Microduck e alivie a carga. O tipo não foi alterado")
    return bus


def imu_profile_readback(op, profile, require_discovery=False):
    bus, err = robotd_bus_status(op)
    info, configured, metadata_error = imu_bus_metadata(bus)
    if metadata_error:
        raise Stop(EXIT_STATE, "readback_mismatch", metadata_error)
    if bus is None or configured != profile:
        raise Stop(EXIT_STATE, "readback_mismatch", "O tipo na configuração do programa principal não foi confirmado exatamente na leitura de retorno; a sessão foi preservada")
    if ((isinstance(info, dict) and (info.get("profile", "legacy") != profile
                                    or (profile == "qinmo" and info.get("protocol") != "feetech")))
            or (require_discovery and not isinstance(info, dict))):
        raise Stop(EXIT_STATE, "readback_mismatch", "O tipo da IMU conectada não foi confirmado na leitura de retorno; não é possível concluir")
    return bus


def imu_profile_restart(op, profile):
    if not restart_robotd(op) or not wait_robotd(op)[0]:
        raise Stop(EXIT_FAIL, "restart_failed", "Falha ao reconectar o programa principal; é possível cancelar para restaurar os parâmetros originais")
    deadline = op.ctx.now() + CALIB_MOTION_WAIT
    while True:
        bus = imu_profile_readback(op, profile)
        if bus.get("mode") == "commissioning" and bus.get("phase") in (*COMMISSIONING_UP, "configuring_bus", "waiting_for_bus"):
            break
        if op.ctx.now() >= deadline:
            raise Stop(EXIT_FAIL, "restart_failed", "O programa principal ainda não voltou ao modo de calibração; é possível cancelar para restaurar os parâmetros originais")
        op.ctx.sleep(CALIB_STATUS_INTERVAL)
    imu_profile_gate(op)
    return bus


def imu_profile_restore(op, m):
    imu_redo_owned(op, m, allow_missing=True)
    errors = []
    directory = IMU_REDO_DIR + "/" + m["session_id"]
    for row in m["files"] + m["config_files"]:
        imu_profile_safe_file(op, row["path"])
        if not _restore_one(op, directory, row, errors):
            raise Stop(EXIT_FAIL, "rollback_failed", "; ".join(errors))
    # Startup recovery never returns to control automatically, even on cancellation.
    if m["original_mode"] == "startup":
        # Hand off to the same fixed factory commissioning flow used by firstboot.
        # This permits a fresh selection / verification / normal firstboot commit.
        recovery = ("# microduck-helper: recovered pre-control IMU selection\n[Service]\nExecStart=\nExecStart=" +
                    " ".join(imu_redo_quote(a) for a in m["exec_args"] + ["--commissioning"]) + "\n").encode()
        if exists(op.ctx, COMMISSIONING_DROPIN) and imu_profile_safe_file(op, COMMISSIONING_DROPIN) != recovery:
            raise Stop(EXIT_STATE, "imu_session_tampered", "O arquivo do modo de calibração de fábrica foi alterado; a sessão foi preservada")
        write_atomic(op.ctx, COMMISSIONING_DROPIN, recovery, 0o644)
        remove(op.ctx, IMU_REDO_DROPIN)
        if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0 or imu_redo_arguments(exec_start(op)) != m["exec_args"] + ["--commissioning"]:
            raise Stop(EXIT_FAIL, "rollback_failed", "Os parâmetros seguros de inicialização da calibração não foram carregados; a sessão foi preservada")
        imu_profile_restart(op, m["old_profile"])
        imu_profile_controllers_restore(op, m["controllers"])
        imu_redo_save(op, m, "cancelled", active=False, reason="Tipo original restaurado e modo de calibração mantido; é possível selecionar e verificar novamente")
        return {}
    remove(op.ctx, IMU_REDO_DROPIN)
    target = m.get("original_args", m["exec_args"])
    if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0 or imu_redo_arguments(exec_start(op)) != target:
        raise Stop(EXIT_FAIL, "rollback_failed", "Os parâmetros originais de inicialização não foram restaurados; a sessão foi preservada")
    expected = _load_toml(op, CALIB)
    mode = m["original_mode"]
    if mode == "commissioning":
        imu_profile_restart(op, m["old_profile"])
        status = imu_redo_readback(op, expected, m["source"])
    else:
        status = imu_redo_restart(op, mode, expected, m["source"])
    imu_profile_controllers_restore(op, m["controllers"])
    imu_redo_save(op, m, "cancelled", active=False)
    return status


def imu_profile_enter(op, args, previous):
    if (previous and previous["active"]) or exists(op.ctx, IMU_REDO_DROPIN):
        raise Stop(EXIT_STATE, "imu_recalibrate_active", "A sessão de calibração já está ativa; conclua ou cancele primeiro")
    original_args = imu_redo_arguments(exec_start(op))
    factory = exists(op.ctx, COMMISSIONING_DROPIN)
    if ("--commissioning" in original_args) != factory or original_args.count("--commissioning") > 1:
        raise Stop(EXIT_STATE, "foreign_commissioning", "Parâmetros externos de inicialização da calibração; nada foi alterado")
    argv = [a for a in original_args if a != "--commissioning"]
    configs = imu_profile_config(op, argv)
    # Build and validate every candidate before writing any file.
    candidates = {path: imu_profile_text(raw, args["profile"]) for path, raw, data in configs}
    bus = imu_profile_gate(op)
    status, err = calibration_status(op)
    if status is None or imu_redo_source(bus, status) != "bus":
        raise Stop(EXIT_STATE, "imu_source_changed", "A fonte da IMU do programa principal não é o barramento ou não pôde ser confirmada; nada foi alterado")
    if imu_profile_configured(bus) != configs[0][2]["bus"].get("imu_profile", "legacy"):
        raise Stop(EXIT_STATE, "readback_mismatch", "O tipo no arquivo diverge do programa principal em execução; nada foi alterado")
    data, _ = read_calibration(op)
    imu_redo_readback(op, data, "bus")
    mode = "commissioning" if factory else ("motion" if bus.get("phase") == "control" else "startup")
    controllers = {"padd": is_active(op, "padd"), "gamesir": is_active(op, GAMESIR),
                   "duck_echo": is_active(op, "duck-echo")}
    ensure_dir(op.ctx, OPLOG_DIR, 0o755)
    ensure_dir(op.ctx, IMU_REDO_DIR, 0o755)
    session = secrets.token_hex(16)
    directory = IMU_REDO_DIR + "/" + session
    ensure_dir(op.ctx, directory, 0o700)
    files, config_files = [], []
    for path, name, rows in ((CALIB, "main.toml", files), (CALIB_SAVED, "saved.toml", files),
                              (IMU_CONFIG, "config.toml", config_files), (IMU_CONFIG_SAVED, "config-saved.toml", config_files)):
        contents = imu_profile_safe_file(op, path)
        if rows is files:
            candidates[path] = imu_profile_unverify(contents)
        meta, _ = file_meta(op.ctx, path)
        meta.update(path=path, name=name)
        if rows is config_files:
            meta["selected_sha256"] = _sha256(candidates[path])
        write_atomic(op.ctx, directory + "/" + name, contents, 0o600)
        rows.append(meta)
    baseline = (json.dumps(data, sort_keys=True) + "\n").encode()
    write_atomic(op.ctx, directory + "/calibration.json", baseline, 0o600)
    m = {"schema": IMU_REDO_SCHEMA, "active": True, "session_id": session, "source": "bus",
         "exec_args": argv, "original_args": original_args, "original_mode": mode, "profile": args["profile"],
         "old_profile": imu_profile_configured(bus), "files": files, "config_files": config_files,
         "controllers": controllers, "calibration_sha256": _sha256(baseline)}
    m["override_sha256"] = _sha256(imu_redo_override(m))
    imu_redo_save(op, m, "entering")
    changed = False
    try:
        imu_profile_controllers_stop(op)
        imu_profile_gate(op)
        if imu_redo_arguments(exec_start(op)) != original_args:
            raise Stop(EXIT_STATE, "readback_mismatch", "Os parâmetros de inicialização do programa principal foram alterados; nada foi modificado")
        for row in files + config_files:
            if _sha256(imu_profile_safe_file(op, row["path"])) != row["sha256"]:
                raise Stop(EXIT_STATE, "readback_mismatch", "A configuração/calibração mudou antes da entrada; nada foi alterado")
        changed = True
        write_atomic(op.ctx, IMU_REDO_DROPIN, imu_redo_override(m), 0o644)
        for row in config_files + files:
            _write_preserving(op, row["path"], candidates[row["path"]], row, 0o644)
            if imu_profile_safe_file(op, row["path"]) != candidates[row["path"]]:
                raise Stop(EXIT_FAIL, "readback_mismatch", "A leitura de retorno da configuração do tipo diverge após a gravação")
        if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0:
            raise Stop(EXIT_FAIL, "restart_failed", "A configuração de modo não foi carregada")
        imu_redo_owned(op, m)
        imu_profile_restart(op, m["profile"])
        imu_redo_save(op, m, "commissioning")
        return op.finish(EXIT_OK, "imu_entered", "Tipo salvo e programa principal reconectado no modo de calibração; conclua a coleta da orientação de instalação e a verificação pelo programa principal", m)
    except Exception as err:
        try:
            if changed:
                imu_profile_restore(op, m)
            else:
                imu_profile_controllers_restore(op, controllers)
                imu_redo_save(op, m, "cancelled", active=False)
        except Exception as rollback_error:
            imu_redo_save(op, m, "recovery_required", reason=str(rollback_error))
            return op.finish(EXIT_FAIL, "rollback_failed", "A seleção e a restauração não foram concluídas; a sessão e o backup permanecem disponíveis e podem ser restaurados pelo cancelamento", m)
        return op.finish(err.code if isinstance(err, Stop) else EXIT_FAIL,
                         err.result if isinstance(err, Stop) else "enter_failed", str(err), m)


def check_imu_redo_args(args):
    action = args.get("action")
    keys = {"enter": ("by", "action", "confirmed", "profile"), "status": ("by", "action"),
            "cancel": ("by", "action", "confirmed", "session_id"),
            "finish": ("by", "action", "session_id", "source", "quat")}
    if action not in keys:
        raise Stop(EXIT_ARGS, "bad_args", "imu-recalibrate aceita somente enter / status / finish / cancel")
    check_keys(args, keys[action], "parâmetros de imu-recalibrate")
    if "profile" in args and args["profile"] not in ("legacy", "qinmo"):
        raise Stop(EXIT_ARGS, "bad_args", "profile deve ser legacy ou qinmo")
    by = check_by(args)
    if action in ("enter", "cancel") and args.get("confirmed") is not True:
        raise Stop(EXIT_ARGS, "bad_args", "Confirme primeiro que o Microduck está estabilizado e sem carga antes de entrar ou cancelar")
    if action in ("finish", "cancel") and not re.fullmatch(r"[0-9a-f]{32}", str(args.get("session_id", ""))):
        raise Stop(EXIT_ARGS, "bad_args", "session_id inválido")
    if action == "finish":
        try:
            q = normalize_quat(args.get("quat"))
        except CalibError as err:
            raise Stop(EXIT_ARGS, "bad_args", str(err)) from err
        if args.get("source") not in IMU_SOURCES or not imu_redo_same(q, args["quat"]):
            raise Stop(EXIT_ARGS, "bad_args", "source / quat normalizado inválidos")
    return by, action


def verb_imu_recalibrate(op, args, raw):
    op.by, action = check_imu_redo_args(args)
    if action != "status" and op.ctx.env.get(DETACH_ENV) != "1":
        return detach(op, raw, "imu-recalibrate")
    op.take_lock("calibração da IMU")
    m = imu_redo_load(op)
    if action == "status":
        return op.finish(EXIT_OK, "imu_status", "Sessão de calibração inicial da IMU lida", m or {"active": False, "phase": "idle"}, record=False)
    if flag_present(op.ctx):
        raise Stop(EXIT_STATE, "bus_held", "A página dos servos está usando o barramento; devolva-o primeiro ao programa principal")
    if "profile" in args or (m and "profile" in m):
        op.service_lock_handle = op.ctx.lock(SERVICE_LOCK)
        if op.service_lock_handle is None:
            raise Stop(EXIT_BUSY, "busy", "O gerenciamento/atualização do programa principal está em andamento; tente novamente mais tarde")
    if action == "enter" and "profile" in args:
        return imu_profile_enter(op, args, m)
    if action == "enter":
        if (m and m["active"]) or exists(op.ctx, IMU_REDO_DROPIN):
            raise Stop(EXIT_STATE, "imu_recalibrate_active", "A sessão de calibração inicial da IMU já está ativa; continue ou cancele")
        if exists(op.ctx, COMMISSIONING_DROPIN):
            raise Stop(EXIT_STATE, "refused", "No modo de calibração de fábrica, faça diretamente a calibração aproximada; não é necessário refazer a sessão")
        argv = imu_redo_arguments(exec_start(op))
        if "--commissioning" in argv:
            raise Stop(EXIT_STATE, "foreign_commissioning", "O programa principal já está em um modo de calibração externo")
        bus = imu_redo_gate(op, "motion")
        data, _ = read_calibration(op)
        status, err = calibration_status(op)
        if status is None:
            raise Stop(EXIT_STATE, "readback_mismatch", f"Não foi possível reler a calibração original:{err}")
        source = imu_redo_source(bus, status)
        imu_redo_readback(op, data, source)
        # Save service states before stopping, and save every backup before touching ExecStart.
        controllers = {"padd": is_active(op, "padd"), "gamesir": is_active(op, GAMESIR)}
        ensure_dir(op.ctx, OPLOG_DIR, 0o755)
        ensure_dir(op.ctx, IMU_REDO_DIR, 0o755)
        session = secrets.token_hex(16)
        directory = IMU_REDO_DIR + "/" + session
        ensure_dir(op.ctx, directory, 0o700)
        files = []
        for path, name in ((CALIB, "main.toml"), (CALIB_SAVED, "saved.toml")):
            meta, contents = file_meta(op.ctx, path)
            meta.update(path=path, name=name)
            if contents is not None:
                imu_redo_file(op, path)
                write_atomic(op.ctx, directory + "/" + name, contents, 0o600)
            files.append(meta)
        baseline = (json.dumps(data, sort_keys=True) + "\n").encode()
        write_atomic(op.ctx, directory + "/calibration.json", baseline, 0o600)
        m = {"schema": IMU_REDO_SCHEMA, "active": True, "session_id": session, "source": source,
             "exec_args": argv, "files": files, "controllers": controllers, "calibration_sha256": _sha256(baseline)}
        m["override_sha256"] = _sha256(imu_redo_override(m))
        imu_redo_save(op, m, "entering")
        override_written = False
        try:
            pads_stop(op)
            if is_active(op, "padd") or is_active(op, GAMESIR):
                raise Stop(EXIT_STATE, "refused", "O serviço do controle remoto não foi interrompido; o modo não foi alterado")
            imu_redo_gate(op, "motion", source)
            if imu_redo_arguments(exec_start(op)) != argv or _sha256(imu_redo_file(op, CALIB)) != files[0]["sha256"]:
                raise Stop(EXIT_STATE, "readback_mismatch", "Os parâmetros do programa principal ou o arquivo de calibração mudaram antes da entrada")
            write_atomic(op.ctx, IMU_REDO_DROPIN, imu_redo_override(m), 0o644)
            override_written = True
            if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0:
                raise Stop(EXIT_FAIL, "restart_failed", "A configuração de modo não foi recarregada")
            imu_redo_owned(op, m)
            imu_redo_restart(op, "commissioning", data, source)
            imu_redo_save(op, m, "commissioning")
            return op.finish(EXIT_OK, "imu_entered", "Calibração inicial da IMU iniciada: mantenha os servos desabilitados, repita a calibração aproximada em repouso/inclinado para a frente e depois verifique", m)
        except Exception as err:
            try:
                if override_written or exists(op.ctx, IMU_REDO_DROPIN):
                    imu_redo_restore_original(op, m)
                else:
                    # A failed second gate has changed no robotd files or mode. Do not
                    # restart a robot whose torque state just became unsafe/unknown.
                    pads_restore(op, controllers)
                    imu_redo_save(op, m, "cancelled", active=False)
            except Exception as rb:
                imu_redo_save(op, m, "recovery_required", reason=str(rb))
                return op.finish(EXIT_FAIL, "rollback_failed", f"A entrada e a restauração não foram concluídas:{rb}；a sessão foi preservada", m)
            if isinstance(err, Stop):
                return op.finish(err.code, err.result, err.reason, m)
            return op.finish(EXIT_FAIL, "enter_failed", f"Falha ao entrar; arquivos e modo originais restaurados:{err}", m)
    if not m or not m["active"] or args["session_id"] != m["session_id"]:
        raise Stop(EXIT_STATE, "no_session", "Esta sessão de calibração inicial da IMU foi alterada ou encerrada")
    imu_redo_owned(op, m, allow_missing=(m["phase"] in ("entering", "finishing", "cancelling", "recovery_required")))
    # A reboot may have started pad services again while the persistent override
    # kept robotd in commissioning. Stop them again before returning to motion.
    if "profile" in m:
        imu_profile_controllers_stop(op)
    else:
        pads_stop(op)
    if is_active(op, "padd") or is_active(op, GAMESIR):
        raise Stop(EXIT_STATE, "refused", "O serviço do controle remoto não foi interrompido; a sessão foi preservada")
    if action == "cancel":
        # Disk config, loaded ExecStart and the live process can differ after a
        # killed transition. Choose the safety gate from a fresh live snapshot;
        # imu_redo_owned independently checks the installed/effective command.
        live, err = robotd_bus_status(op)
        mode = (live or {}).get("mode")
        if mode not in ("motion", "commissioning"):
            raise Stop(EXIT_STATE, "refused", f"Não foi possível reler o modo atual do programa principal antes do cancelamento:{err or mode}；a sessão foi preservada")
        if "profile" in m:
            imu_profile_gate(op)
        else:
            imu_redo_gate(op, mode, m["source"])
        imu_redo_save(op, m, "cancelling")
        try:
            status = imu_redo_restore_original(op, m)
            note = ("Tipo original e calibração da IMU restaurados; modo de calibração mantido. É possível selecionar novamente e verificar"
                    if m.get("original_mode") in ("startup", "commissioning") else
                    "Recalibração cancelada; calibração original da IMU e modo de movimento restaurados, servos mantidos desabilitados")
            return op.finish(EXIT_OK, "imu_cancelled", note, dict(m, calibration=status))
        except Exception as err:
            imu_redo_save(op, m, "recovery_required", reason=str(err))
            return op.finish(EXIT_FAIL, "cancel_failed", f"O cancelamento não foi concluído; a sessão e o backup continuam disponíveis:{err}", m)
    source, quat = args["source"], args["quat"]
    if source != m["source"]:
        raise Stop(EXIT_STATE, "imu_source_changed", "A fonte atual difere daquela registrada ao iniciar a sessão")
    imu_redo_gate(op, "commissioning", source)
    current = _load_toml(op, CALIB)
    if not imu_redo_same(normalized_calibration(current), normalized_calibration(_load_toml(op, CALIB_SAVED))):
        raise Stop(EXIT_STATE, "readback_mismatch", "A calibração principal diverge do arquivo saved na leitura de retorno")
    imu_redo_readback(op, current, source, quat)
    if "profile" in m:
        imu_profile_config(op, m["exec_args"])
        for row in m["config_files"]:
            if _sha256(imu_profile_safe_file(op, row["path"])) != row.get("selected_sha256"):
                raise Stop(EXIT_STATE, "readback_mismatch", "O arquivo de configuração do tipo selecionado foi alterado; a sessão foi preservada")
        imu_profile_readback(op, m["profile"], require_discovery=True)
    directory = IMU_REDO_DIR + "/" + m["session_id"]
    baseline = json.loads(imu_redo_file(op, directory + "/calibration.json"))
    import copy
    def without_allowed(cal):
        cal = copy.deepcopy(cal)
        cal.pop("motion_enabled", None)
        if source == "bus":
            cal.pop("imu_mount_quat", None)
            cal.pop("imu_mount_verified", None)
            cal.pop("imu_bus_protocol", None)
            cal.pop("imu_bus_profile", None)
        else:
            mount = (cal.get("imu_mounts") or {}).get(source)
            if isinstance(mount, dict):
                mount.pop("quat", None)
                mount.pop("verified", None)
        return normalized_calibration(cal)
    if not imu_redo_same(without_allowed(baseline), without_allowed(current)):
        raise Stop(EXIT_STATE, "readback_mismatch", "Outros dados de calibração, além da orientação atual da IMU e de motion_enabled, foram alterados; interrompa a conclusão")
    before = {path: file_meta(op.ctx, path) for path in (CALIB, CALIB_SAVED)}
    text = before[CALIB][1].decode("utf-8")
    replacement = "motion_enabled = " + _bool_text(baseline.get("motion_enabled"))
    text, count = re.subn(r"(?m)^motion_enabled\s*=\s*(?:true|false)\s*(?:#[^\n]*)?$", replacement, text)
    if count != 1:
        raise Stop(EXIT_STATE, "bad_toml", "motion_enabled não tem uma forma única no nível superior; nenhuma alteração será presumida")
    expected = tomllib.loads(text)
    restored = copy.deepcopy(current)
    restored["motion_enabled"] = baseline["motion_enabled"]
    if not imu_redo_same(expected, restored):
        raise Stop(EXIT_STATE, "bad_toml", "Restaurar motion_enabled alteraria outros campos; interrompa a conclusão")
    imu_redo_save(op, m, "finishing", expected_quat=quat)
    try:
        for path in (CALIB, CALIB_SAVED):
            _write_preserving(op, path, text.encode(), before[path][0], 0o644)
            if not imu_redo_same(_load_toml(op, path), expected):
                raise Stop(EXIT_FAIL, "readback_mismatch", "O arquivo diverge na leitura de retorno após a instalação")
        imu_redo_owned(op, m)
        remove(op.ctx, IMU_REDO_DROPIN)
        target_args = m.get("original_args", m["exec_args"])
        if op.ctx.run(["systemctl", "daemon-reload"])[0] != 0 or imu_redo_arguments(exec_start(op)) != target_args:
            raise Stop(EXIT_FAIL, "restart_failed", "Os parâmetros originais de inicialização não foram restaurados")
        target_mode = "commissioning" if m.get("original_mode") == "commissioning" else "motion"
        status = imu_redo_restart(op, target_mode, expected, source)
        imu_redo_readback(op, expected, source, quat)
        if "profile" in m:
            imu_profile_controllers_restore(op, m["controllers"])
        else:
            pads_restore(op, m["controllers"])
        imu_redo_save(op, m, "finished", active=False)
        note = ("Orientação da IMU verificada e tipo salvo; continue o processo de calibração de fábrica"
                if target_mode == "commissioning" else
                "A calibração inicial da IMU foi verificada novamente; calibração dos servos preservada, modo de movimento restaurado e servos desabilitados")
        return op.finish(EXIT_OK, "imu_finished", note, dict(m, calibration=status))
    except Exception as err:
        # Keep the successfully verified commissioning state, never the original unverified candidate.
        try:
            for path, (meta, contents) in before.items():
                _write_preserving(op, path, contents, meta, 0o644)
            if exists(op.ctx, IMU_REDO_DROPIN) and imu_redo_file(op, IMU_REDO_DROPIN) != imu_redo_override(m):
                raise Stop(EXIT_STATE, "imu_session_tampered", "O arquivo de modo foi alterado e não será sobrescrito")
            write_atomic(op.ctx, IMU_REDO_DROPIN, imu_redo_override(m), 0o644)
            op.ctx.run(["systemctl", "daemon-reload"])
            imu_redo_restart(op, "commissioning", current, source)
            imu_redo_save(op, m, "finish_failed", reason=str(err))
        except Exception as rb:
            imu_redo_save(op, m, "recovery_required", reason=str(rb))
        return op.finish(EXIT_FAIL, "finish_failed", f"A conclusão falhou; a sessão de calibração e a orientação verificada foram preservadas. Tente novamente ou cancele:{err}", m)


# Verbos

def verb_take(op, args):
    check_keys(args, ("by", "allow_seated"), "parâmetros de bus-take")
    op.by = check_by(args)
    allow_seated = args.get("allow_seated", False)
    if not isinstance(allow_seated, bool):
        raise Stop(EXIT_ARGS, "bad_args", "allow_seated deve ser true / false")
    op.take_lock()
    imu_redo_conflict(op)
    guard_installed(op)
    session_open = flag_present(op.ctx)
    if session_open:
        op.emit("session", "info", "A sinalização já está ativa (a sessão anterior de ajuste dos servos não terminou); basta confirmar que o programa principal está parado")
    started_hold = False
    if hold_active(op):
        op.emit("lock", "info", "O bloqueio de gerenciamento já está com o Studio")
    else:
        if not hold_start(op):
            raise Stop(EXIT_BUSY, "busy", "Não foi possível obter /run/microduck-service-management.lock. Há um script em execução na placa? Aguarde e tente novamente")
        started_hold = True
        op.emit("lock", "info", "Bloqueio de gerenciamento obtido (microduck-bus-hold)")
    pads = pads_stop(op)
    why = "O programa principal não está em execução"
    if running(robotd_state(op)):
        try:
            why = gate(op, allow_seated)
        except Stop:
            pads_restore(op, pads)
            if started_hold and not session_open:
                hold_stop(op)
            raise
    op.emit("gate", "info", f"A transferência pode ser iniciada:{why}")
    flag_write(op, "bus-take")
    op.emit("flag", "info", "Sinalização ativada: robotd não poderá iniciar a partir de agora (ConditionPathExists=!)")
    if not stop_robotd(op):
        raise Stop(EXIT_FAIL, "stop_failed", "Não foi possível parar o programa principal nem após KILL. A sinalização continuará ativa; não abra a porta serial",
                   {"flag": True, "lock": True})
    free, who = port_free(op)
    if free is not True:
        raise Stop(EXIT_FAIL, "port_busy",
                   f"A porta serial {PORT} continua ocupada ({who}); a sinalização segue ativa. Verifique qual processo usa a porta" if free is False else f"Não foi possível verificar se a porta serial está ocupada: {who}",
                   {"flag": True, "lock": True})
    return op.finish(EXIT_OK, "taken", f"Barramento transferido: {why}; o programa principal está parado e o Studio pode abrir a porta serial",
                     {"pads_were": pads, "session_was_open": session_open})


def check_give_args(args):
    check_keys(args, ("by", "soft", "marker"), "parâmetros de bus-give-back")
    by = check_by(args)
    soft = "soft" in args
    if soft == ("marker" in args):
        raise Stop(EXIT_ARGS, "bad_args", "bus-give-back deve ser {soft: true} ou {marker: {...}}; escolha uma das opções")
    if soft and args["soft"] is not True:
        raise Stop(EXIT_ARGS, "bad_args", "soft só pode ser true")
    return by, soft


def verb_give_back(op, args, raw):
    op.by, soft = check_give_args(args)
    if not soft:
        build_marker(op, args["marker"], op.by)        # Valida aqui primeiro para não encaminhar argumentos inválidos
    if op.ctx.env.get(DETACH_ENV) != "1":
        return detach(op, raw)
    op.take_lock()
    if not flag_present(op.ctx) or not hold_active(op):
        raise Stop(EXIT_STATE, "no_session", "Não há sessão de ajuste dos servos (sinalização ou bloqueio ausente); o barramento não pertence ao Studio e não há nada a devolver",
                   {"flag": flag_present(op.ctx), "lock": hold_active(op)})
    requested = parse_requested_ms(op)
    if abort_requested(op, requested, consume=False):
        remove(op.ctx, ABORT)
        raise Stop(EXIT_BUSY, "aborted", "A devolução foi interrompida antes de começar (a página solicitou o desligamento do torque)", {"lock": True})
    stale = read_json(op.ctx, ABORT)
    if stale is not None or exists(op.ctx, ABORT):
        remove(op.ctx, ABORT)
        op.emit("abort", "info", "Limpando uma solicitação de cancelamento anterior a esta devolução")
    return give_soft(op, requested) if soft else give_marker(op, args["marker"], requested)


def parse_requested_ms(op):
    v = op.ctx.env.get(REQUESTED_ENV, "")
    return int(v) if re.fullmatch(r"\d{1,15}", v or "") else int(op.ctx.now() * 1000)


def abort_requested(op, requested_ms, consume=True):
    a = read_json(op.ctx, ABORT)
    if a is None:
        return False
    m = a.get("mono_ms")
    if is_int(m) and m >= requested_ms:
        if consume:
            remove(op.ctx, ABORT)
        return True
    return False


def detach(op, raw, verb="bus-give-back"):
    """Na primeira chamada:usa systemd-run para executar novamente em uma unidade temporária separada, encaminhando stdin e saída sem alterações.
    Se o Studio fechar, o processo systemd-run daqui também termina, mas o processo na unidade temporária conclui o trabalho (ignora SIGPIPE e grava somente no journal se não puder enviar a saída)."""
    token = secrets.token_hex(8)
    stamp = f"{int(time.time())}-{op.ctx.pid()}"
    requested = int(op.ctx.now() * 1000)
    unit = ("microduck-calib-" if verb == "calib-commit" else "microduck-handover-") + stamp
    argv = ["systemd-run", "--wait", "--pipe", "--collect", "--quiet", f"--unit={unit}",
            f"--setenv={DETACH_ENV}=1", f"--setenv={REQUEST_ENV}={token}", f"--setenv={REQUESTED_ENV}={requested}",
            op.ctx.self_path, verb]
    rc = op.ctx.relay(argv, raw, op.write_out)
    last = read_json(op.ctx, LAST)
    if last and last.get("request_id") == token and is_int(last.get("exit")):
        return last["exit"]
    if rc in (EXIT_OK, EXIT_ARGS, EXIT_STATE, EXIT_BUSY, EXIT_FAIL, EXIT_RETAKE) and rc != EXIT_OK:
        return rc
    return op.finish(EXIT_FAIL, "detach_failed",
                     f"A unidade separada não retornou resultado (código de saída do systemd-run {rc}):consulte journalctl -t microduck-helper",
                     {"systemd_run_rc": rc, "unit": unit})


def startup_step4(op):
    try:
        rep = op.ctx.startup_report(1.0)
    except RpcError:
        return None
    steps = rep.get("steps") if isinstance(rep, dict) else None
    s4 = steps.get("4") if isinstance(steps, dict) else None
    return s4.get("status") if isinstance(s4, dict) else None


def bus_status(op):
    try:
        b = op.ctx.rpc("robot.busStatus", {}, 0.5)
        return b if isinstance(b, dict) else None
    except RpcError:
        return None


def robotd_up(bus):
    """O programa principal iniciou?:No modo de movimento, chegou a control; no modo de calibração, retornou um instantâneo em tempo real(read_error também conta: iniciou, mas ocorreu um erro ao ler os servos)."""
    if not isinstance(bus, dict):
        return False
    mode, phase = bus.get("mode"), bus.get("phase")
    return (mode == "motion" and phase == "control") or (mode == "commissioning" and phase in COMMISSIONING_UP)


def still_starting_text(bus, waited):
    """Tempo esgotado: o programa principal ainda responde, mas permanece na fase de inicialização. Relata o estado real, como no aviso da visão geral do Studio."""
    phase, err = bus.get("phase"), bus.get("error")
    if err:
        return f"O programa principal informa “iniciando” há {waited:.0f} s ({phase}: {err}); consulte a página de registros para ver a última mensagem"
    return f"O programa principal informa “iniciando” há {waited:.0f} s (phase={phase}): {STILL_STARTING}"


def start_robotd(op):
    op.ctx.run(["systemctl", "reset-failed", "robotd"])
    rc, out, err = op.ctx.run(["systemctl", "start", "--no-block", "robotd"])
    op.emit("start", "info", "Iniciando o programa principal (após reset-failed; o resultado é determinado por ActiveState/ConditionResult, não por este código de saída)",
            {"rc": rc, "stderr": err.strip()[:200]})


def retake(op, reason, detail=None):
    """Se a transferência falhar: reativa a sinalização → para robotd (sem gravar torque) → remove o marcador → mantém o bloqueio. O Studio reabre a porta serial e continua mantendo o controle."""
    op.emit("retake", "warn", f"Devolvendo o barramento ao Studio: {reason}", detail)
    flag_write(op, "retake")
    ok = stop_robotd(op, "retake")
    if remove(op.ctx, MARKER):
        op.emit("retake", "info", "Removendo o marcador de transferência que não foi lido")
    free, who = port_free(op)
    d = dict(detail or {}, flag=True, lock=True, port_free=free)
    if not ok:
        return op.finish(EXIT_FAIL, "retake_failed", f"{reason}; também não foi possível parar o programa principal. Não abra a porta serial", d)
    if free is not True:
        return op.finish(EXIT_FAIL, "retake_failed", f"{reason}; a porta serial continua ocupada ({who})", d)
    return op.finish(EXIT_RETAKE, "retake", reason, d)


def declined_reason(bus):
    ho = bus.get("handover") if isinstance(bus.get("handover"), dict) else {}
    detail = {k: ho.get(k) for k in ("reason", "joint", "item") if ho.get(k) is not None}
    if not detail and bus.get("error"):
        detail["reason"] = bus.get("error")
    parts = [f"#{detail['joint']}" if detail.get("joint") is not None else None, detail.get("item"), detail.get("reason")]
    text = "O programa principal rejeitou a validação do marcador de transferência: " + ", ".join(str(p) for p in parts if p)
    return text, detail


def give_marker(op, given, requested):
    marker = build_marker(op, given, op.by)
    free, who = port_free(op)
    if free is not True:
        raise Stop(EXIT_FAIL, "refused",
                   f"A porta serial {PORT} continua ocupada ({who}). O Studio fechou a porta? A devolução não ocorreu e a sessão continua ativa" if free is False else f"Não foi possível verificar a porta serial: {who}",
                   {"flag": True, "lock": True})
    ensure_dir(op.ctx, MARKER_DIR, 0o700)
    write_atomic(op.ctx, MARKER, (json.dumps(marker, ensure_ascii=False) + "\n").encode("utf-8"), 0o600)
    op.emit("marker", "info", "Marcador de transferência gravado", {"ttl_ms": marker["ttl_ms"], "mono_ms": marker["mono_ms"]})
    remove(op.ctx, FLAG)
    op.emit("flag", "info", "Desativando a sinalização (mantendo o bloqueio de gerenciamento até obter o resultado)")
    start_robotd(op)
    t_start = op.ctx.now()
    seen_read = False
    last_phase = None
    while True:
        op.ctx.sleep(GIVE_POLL)
        elapsed = op.ctx.now() - t_start
        if abort_requested(op, requested):
            return op.finish(EXIT_BUSY, "aborted", "Devolução interrompida (a página solicitou o desligamento do torque): bus-abort está parando o programa principal e devolvendo o barramento ao Studio",
                             {"lock": True})
        st = robotd_state(op)
        marker_left = exists(op.ctx, MARKER)
        if not marker_left and not seen_read:
            seen_read = True
            op.emit("wait", "info", "O programa principal leu o marcador de transferência")
        if stopped(st) and st.get("ConditionResult") == "no":
            return retake(op, "O Condition impediu o início do programa principal (a sinalização reapareceu?)", st)
        if st.get("Result") == "start-limit-hit":
            return retake(op, "O programa principal atingiu o limite de tentativas de inicialização(start-limit-hit)", st)
        bus = bus_status(op)
        if bus is not None:
            phase = bus.get("phase")
            if phase != last_phase:
                op.emit("wait", "info", f"Fase do programa principal={phase}")
                last_phase = phase
            ho = bus.get("handover") if isinstance(bus.get("handover"), dict) else {}
            if phase == "handover_declined" or ho.get("result") == "declined":
                text, detail = declined_reason(bus)
                return retake(op, text, detail)
            if bus.get("mode") == "commissioning" and robotd_up(bus):
                # O modo de calibração não aceita o marcador de transferência: ao abrir o barramento, desabilita primeiro todos os servos (torque_off em feetech_commissioning.rs); não há controle a retomar.
                # Se já iniciou, não aguarde 15 segundos para retomar o barramento.
                remove(op.ctx, MARKER)
                pads_start(op)
                hold_stop(op)
                return op.finish(EXIT_FAIL, "limp", "O programa principal iniciou no modo de calibração: esse modo não assume a manutenção da postura; todos os servos já foram desabilitados na inicialização",
                                 {"mode": "commissioning", "phase": phase})
            if phase == "control":
                s4 = startup_step4(op)
                if s4 == "success":
                    if ho.get("result") == "adopted":
                        remove(op.ctx, ABORT)
                        pads_start(op)
                        hold_stop(op)
                        return op.finish(EXIT_OK, "adopted", "O programa principal assumiu a manutenção da postura: os 15 servos estão energizados, mas o modelo não foi iniciado; toque em “Ficar de pé” para voltar à postura em pé",
                                         {"handover": ho, "ms_to_adopt": int(elapsed * 1000)})
                    # Entrou no ciclo de controle, mas não assumiu a transferência: robotd não reconheceu o marcador (versão antiga/opção desativada) ou reiniciou após assumir o controle.
                    # Nos dois casos, todos os servos já foram desabilitados como de costume; não há controle a retomar.
                    remove(op.ctx, MARKER)
                    pads_start(op)
                    hold_stop(op)
                    why = ("O programa principal não reconheceu o marcador de transferência (versão antiga ou opção desativada no drop-in)" if marker_left
                           else "O programa principal não assumiu o controle (talvez tenha reiniciado após a transferência)")
                    return op.finish(EXIT_FAIL, "limp", f"{why}: todos os servos foram desabilitados como de costume", {"handover": ho or None})
        if marker_left and elapsed >= MARKER_READ_TIMEOUT:
            return retake(op, f"O marcador de transferência não foi lido em {MARKER_READ_TIMEOUT:.0f} s (o programa principal não iniciou ou travou na calibração/verificação dos parâmetros)",
                          {"robotd": st, "phase": last_phase})
        if elapsed >= ADOPT_TIMEOUT:
            return retake(op, f"A etapa 4 da inicialização não terminou em {ADOPT_TIMEOUT:.0f} s (provavelmente aguardando a IMU)",
                          {"robotd": st, "phase": last_phase})


def give_soft(op, requested):
    free, who = port_free(op)
    if free is not True:
        raise Stop(EXIT_FAIL, "refused",
                   f"A porta serial {PORT} continua ocupada ({who}). O Studio fechou a porta?" if free is False else f"Não foi possível verificar a porta serial: {who}",
                   {"flag": True, "lock": True})
    if remove(op.ctx, MARKER):
        op.emit("marker", "info", "Removendo marcador de transferência antigo (não é necessário para devolução suave)")
    remove(op.ctx, FLAG)
    op.emit("flag", "info", "Desativando a sinalização")
    start_robotd(op)
    t_start = op.ctx.now()
    last_bus = None
    while True:
        op.ctx.sleep(GIVE_POLL)
        if abort_requested(op, requested):
            return op.finish(EXIT_BUSY, "aborted", "Devolução interrompida (a página solicitou o desligamento do torque)", {"lock": True})
        st = robotd_state(op)
        if stopped(st) and st.get("ConditionResult") == "no":
            hold_stop(op)
            return op.finish(EXIT_FAIL, "soft_failed", "O Condition impediu o início do programa principal (a sinalização reapareceu?)", st)
        bus = bus_status(op)
        if bus is not None:
            last_bus = bus
        # Considera-se iniciado em motion/control ou quando retorna um instantâneo em tempo real no modo de calibração (ready/moving/read_error/stop_unconfirmed/power_pending).
        if robotd_up(bus) and startup_step4(op) == "success":
            pads_start(op)
            hold_stop(op)
            if bus.get("mode") == "commissioning":
                err = bus.get("last_cycle_error") if bus.get("phase") == "read_error" else None
                return op.finish(EXIT_OK, "soft", "Barramento devolvido: o programa principal iniciou no modo de calibração (todos os servos desabilitados como de costume)"
                                 + (f"; ocorreu um erro ao ler os servos: {err}" if err else ""),
                                 {"mode": "commissioning", "phase": bus.get("phase")})
            return op.finish(EXIT_OK, "soft", "Barramento devolvido: o programa principal iniciou (todos os servos desabilitados como de costume)")
        if op.ctx.now() - t_start >= SOFT_TIMEOUT:
            pads_start(op)
            hold_stop(op)
            if isinstance(last_bus, dict) and last_bus.get("phase") in STARTING_PHASES:
                # O programa principal responde, mas continua na fase de inicialização (o modo de calibração do fork antigo sempre informa configuring_bus): é considerado não iniciado como antes; a mensagem relata o estado real.
                # msg também é incluído em detail: o Studio lê apenas detail da linha done para mostrar o texto completo na interface, sem afirmar que o programa não inicia.
                text = still_starting_text(last_bus, SOFT_TIMEOUT)
                return op.finish(EXIT_FAIL, "soft_failed", text,
                                 dict(st, phase=last_bus.get("phase"), mode=last_bus.get("mode"), still_starting=True, msg=text))
            return op.finish(EXIT_FAIL, "soft_failed",
                             f"O programa principal não concluiu a inicialização em {SOFT_TIMEOUT:.0f} s (os servos já estão desabilitados; não é necessário retomar o barramento); consulte os registros do robotd", st)


def require_robotctl(op):
    if not os.path.isfile(op.ctx.p(ROBOTCTL)):
        raise Stop(EXIT_FAIL, "no_robotctl", f"Não foi possível localizar o robotctl oficial:{ROBOTCTL}", {"path": ROBOTCTL})


def verb_pad_pair(op, args):
    """Executa o robotctl pad pair --json oficial: parar btd e reiniciar o Bluetooth são tarefas do robotctl. Aqui, apenas executa o comando e lê o resultado.
    Não altera a sinalização do barramento, a unidade hold, robotd nem o bloqueio de gerenciamento; usa helper.lock para evitar pareamentos simultâneos."""
    op.by, mac, timeout = check_pad_pair_args(args)
    op.take_lock("operação do controle remoto")
    require_robotctl(op)
    limit = timeout + PAD_EXTRA_S
    argv = [ROBOTCTL, "pad", "pair", "--json", "--timeout", str(timeout)]
    if mac:
        argv.append(mac)
    op.emit("pad-pair", "info", f"Executando robotctl pad pair oficial (limite de {limit} s)",
            {"argv": argv[1:], "by": op.by})
    rc, out, err, timed_out = op.ctx.run_robotctl(argv, limit)
    stderr = _stderr_lines(err)
    if timed_out:
        return op.finish(EXIT_FAIL, "timeout", f"robotctl pad pair excedeu {limit} s e foi encerrado",
                         {"stderr": stderr, "stdout": out[-2000:], "rc": None})
    try:
        pair = json.loads((out or "").strip())
    except ValueError:
        pair = None
    if not isinstance(pair, dict) or pair.get("outcome") not in ("paired", "failed"):
        why = (err or out or "").strip()[:600] or f"robotctl código de saída {rc}"
        return op.finish(EXIT_FAIL, "bad_output", f"A resposta do robotctl não pôde ser interpretada: {why}",
                         {"stderr": stderr, "stdout": out[-2000:], "rc": rc})
    detail = {"pair": pair, "stderr": stderr, "stdout": out.strip()[:4000], "rc": rc}
    if pair.get("outcome") == "paired":
        pad = pair.get("pad") if isinstance(pair.get("pad"), dict) else {}
        who = pad.get("name") or pad.get("mac") or "controle remoto"
        return op.finish(EXIT_OK, "paired", f"Pareado: {who}", detail)
    reason = pair.get("reason") or "other"
    detail["reason"] = reason
    text = f"O robotctl informou falha no pareamento: {reason}"
    if pair.get("detail"):
        text += f"({pair['detail']})"
    return op.finish(EXIT_FAIL, "pair_failed", text, detail)


def verb_pad_forget(op, args):
    op.by, mac = check_pad_forget_args(args)
    op.take_lock("operação do controle remoto")
    require_robotctl(op)
    argv = [ROBOTCTL, "pad", "forget", mac]
    op.emit("pad-forget", "info", f"Executando robotctl pad forget oficial {mac}", {"argv": argv[1:], "by": op.by})
    rc, out, err, timed_out = op.ctx.run_robotctl(argv, FORGET_TIMEOUT_S)
    stderr = _stderr_lines(err)
    detail = {"stdout": out.strip()[:4000], "stderr": stderr, "rc": rc}
    if timed_out:
        return op.finish(EXIT_FAIL, "timeout", f"robotctl pad forget excedeu {FORGET_TIMEOUT_S} s e foi encerrado", detail)
    if re.search(rf"^forgot\s+{re.escape(mac)}\b", out or "", re.M | re.I):
        removed = True
    elif re.search(rf"{re.escape(mac)}\s+was not paired", out or "", re.I):
        removed = False
    else:
        removed = None
    detail["removed"] = removed
    if rc != 0:
        why = (err or out or "").strip()[:600] or f"robotctl código de saída {rc}"
        return op.finish(EXIT_FAIL, "forget_failed", f"robotctl pad forget falhou: {why}", detail)
    return op.finish(EXIT_OK, "forgotten",
                     f"Dispositivo {mac} removido" if removed is not False else f"{mac} não estava pareado", detail)


def verb_abort(op, args):
    """Interrompe a transferência. Não usa helper.lock para não ficar bloqueado por bus-give-back em execução. As etapas podem ser repetidas."""
    check_keys(args, ("by",), "parâmetros de bus-abort")
    op.by = check_by(args)
    if not (flag_present(op.ctx) or hold_active(op) or exists(op.ctx, MARKER)):
        raise Stop(EXIT_STATE, "no_session",
                   "Não há sessão de ajuste dos servos (sinalização, bloqueio de gerenciamento e marcador ausentes); nada foi cancelado e o programa principal não foi afetado")
    if not flag_present(op.ctx):
        flag_write(op, "bus-abort")
        op.emit("flag", "info", "Ativar a sinalização")
    ensure_dir(op.ctx, HELPER_DIR, 0o755)
    write_atomic(op.ctx, ABORT, (json.dumps({"by": op.by, "mono_ms": int(op.ctx.now() * 1000)}) + "\n").encode(), 0o644)
    killed = False
    if running(robotd_state(op)):
        op.ctx.run(["systemctl", "kill", "-s", "KILL", "robotd"])
        killed = True
    deadline = op.ctx.now() + ABORT_KILL_WAIT
    st = robotd_state(op)
    while running(st) and op.ctx.now() < deadline:
        op.ctx.sleep(ABORT_POLL)
        st = robotd_state(op)
    removed = remove(op.ctx, MARKER)
    free, who = port_free(op)
    while free is False and op.ctx.now() < deadline:
        op.ctx.sleep(ABORT_POLL)
        free, who = port_free(op)
    hold = hold_active(op)
    if not hold:
        hold = hold_start(op)
    detail = {"killed": killed, "marker_removed": removed, "lock": hold, "robotd": st}
    if running(st):
        return op.finish(EXIT_FAIL, "abort_incomplete", "O programa principal não parou após KILL; não abra a porta serial. Desligar a alimentação é a opção mais segura", detail)
    if free is not True:
        return op.finish(EXIT_FAIL, "abort_incomplete", f"A porta serial continua ocupada({who})", detail)
    reason = "Transferência cancelada: o programa principal está parado e o Studio pode abrir a porta serial para desabilitar os servos"
    if not hold:
        reason += " (não foi possível obter o bloqueio de gerenciamento; talvez haja um script em execução na placa, mas a sinalização impede o programa principal de iniciar)"
    return op.finish(EXIT_OK, "aborted", reason, detail)


# Ponto de acesso Wi-Fi: durante a configuração, o Studio o desativa antes de permitir que configd se conecte à rede doméstica.

def _nmcli_unescape(s):
    """nmcli -t escapa dois-pontos e barras invertidas (o SSID pode conter dois-pontos); desfaz o escape do nome da conexão, que é controlado por nós."""
    return (s or "").replace("\\:", ":").replace("\\\\", "\\")


def wifi_active(op):
    """Verifica se wlan0 está conectado a Microduck-Hotspot: retorna o nome do dispositivo ou None.
    Se não for possível consultar (nmcli ausente ou erro), lança Stop para que o chamador informe a etapa que falhou."""
    rc, out, err = op.ctx.run(["nmcli", "-t", "-f", "NAME,DEVICE", "connection", "show", "--active"])
    if rc != 0:
        why = (err or out).strip()[:300] or f"nmcli código de saída {rc}"
        raise Stop(EXIT_FAIL, "nmcli_failed", f"Não foi possível consultar a conexão de rede atual: {why}", {"rc": rc})
    for line in (out or "").splitlines():
        name, sep, dev = line.partition(":")
        if sep and _nmcli_unescape(name) == HOTSPOT:
            return _nmcli_unescape(dev) or "?"
    return None


def check_wifi_args(args, verb):
    check_keys(args, ("by", "ssid") if verb == "wifi-hotspot-down" else ("by",), f"parâmetros de {verb}")
    by = check_by(args)
    ssid = args.get("ssid")
    if ssid is not None:
        if not isinstance(ssid, str) or len(ssid.encode("utf-8")) > 32 or "\x00" in ssid:
            raise Stop(EXIT_ARGS, "bad_args", "ssid deve ser uma string de 0 a 32 bytes")
    return by, ssid


def write_studio_connecting(op, ssid):
    """Antes de desativar o ponto de acesso, grava o arquivo de controle do netcheck; até o prazo, ele não interfere e o Studio pode conectar configd com segurança."""
    ensure_dir(op.ctx, STUDIO_CONNECTING_DIR, 0o755)
    payload = {"until": int(time.time()) + STUDIO_CONNECTING_S, "ssid": ssid or ""}
    write_atomic(op.ctx, STUDIO_CONNECTING,
                 (json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8"), 0o644)
    op.emit("connecting-window", "info", f"Janela de conexão registrada ({STUDIO_CONNECTING_S} s, SSID: {ssid or 'não informado'})")


def clear_studio_connecting(op):
    try:
        if remove(op.ctx, STUDIO_CONNECTING):
            op.emit("connecting-window", "info", "Arquivo da janela de conexão removido")
    except OSError as e:
        op.emit("connecting-window", "warn", f"Falha ao remover o arquivo da janela de conexão: {type(e).__name__}: {e}")


def verb_wifi_hotspot_down(op, args):
    """Desativa o ponto de acesso. Se já estiver desligado, considera sucesso (incluindo “conexão não ativa” do nmcli). Aguarda wlan0 desconectar por até 10 s."""
    op.by, ssid = check_wifi_args(args, "wifi-hotspot-down")
    op.take_lock("operação de Wi-Fi", WIFI_LOCK)
    active = wifi_active(op)
    if active is None:
        op.emit("hotspot", "info", "O ponto de acesso já está desativado")
        return op.finish(EXIT_OK, "already_down", "O ponto de acesso já estava desativado", {"device": None})
    op.emit("hotspot", "info", f"Desativando o ponto de acesso: {active} está conectado a {HOTSPOT}", {"device": active})
    try:
        write_studio_connecting(op, ssid)
    except (OSError, Stop) as e:
        why = e.reason if isinstance(e, Stop) else f"{type(e).__name__}: {e}"
        return op.finish(EXIT_FAIL, "window_failed", f"Não foi possível gravar o arquivo da janela de conexão: {why}", {"path": STUDIO_CONNECTING})
    rc, out, err = op.ctx.run(["nmcli", "connection", "down", HOTSPOT], timeout=NMCLI_DOWN_TIMEOUT)
    msg = (err or out).strip()[:300]
    if rc != 0:
        if re.search(r"not an active connection|not active|no active connection", msg, re.I):
            return op.finish(EXIT_OK, "already_down", "O ponto de acesso já estava desativado", {"rc": rc, "stderr": msg})
        return op.finish(EXIT_FAIL, "down_failed", f"Falha do nmcli ao desativar o ponto de acesso: {msg or f'código de saída {rc}'}",
                         {"rc": rc, "stderr": msg})
    deadline = op.ctx.now() + WIFI_DOWN_WAIT
    while op.ctx.now() < deadline:
        if wifi_active(op) is None:
            op.emit("hotspot", "info", "Ponto de acesso desativado; wlan0 não está mais conectado a Microduck-Hotspot")
            return op.finish(EXIT_OK, "hotspot_down", "Ponto de acesso desativado", {"device": active})
        op.ctx.sleep(WIFI_POLL)
    return op.finish(EXIT_FAIL, "timeout", f"Após {WIFI_DOWN_WAIT:.0f} s, wlan0 ainda está conectado a {HOTSPOT}",
                     {"device": active})


def verb_wifi_hotspot_up(op, args):
    """Ativa o ponto de acesso. Se já estiver ativo, considera sucesso. Aguarda até 30 s após nmcli up para wlan0 conectar à rede."""
    op.by, _ = check_wifi_args(args, "wifi-hotspot-up")
    op.take_lock("operação de Wi-Fi", WIFI_LOCK)
    active = wifi_active(op)
    if active is not None:
        op.emit("hotspot", "info", f"O ponto de acesso já está ativo ({active})")
        clear_studio_connecting(op)
        return op.finish(EXIT_OK, "already_up", "O ponto de acesso já estava ativo", {"device": active})
    op.emit("hotspot", "info", f"Ativando o ponto de acesso: nmcli connection up {HOTSPOT}")
    started = op.ctx.now()
    rc, out, err = op.ctx.run(["nmcli", "connection", "up", HOTSPOT], timeout=WIFI_UP_WAIT)
    msg = (err or out).strip()[:300]
    if rc != 0:
        return op.finish(EXIT_FAIL, "up_failed", f"Falha do nmcli ao ativar o ponto de acesso: {msg or f'código de saída {rc}'}",
                         {"rc": rc, "stderr": msg})
    clear_studio_connecting(op)
    deadline = started + WIFI_UP_WAIT
    while op.ctx.now() < deadline:
        dev = wifi_active(op)
        if dev is not None:
            op.emit("hotspot", "info", f"Ponto de acesso ativado ({dev})")
            return op.finish(EXIT_OK, "hotspot_up", "Ponto de acesso ativado", {"device": dev})
        op.ctx.sleep(WIFI_POLL)
    return op.finish(EXIT_FAIL, "timeout", f"Após {WIFI_UP_WAIT:.0f} s, wlan0 ainda não se conectou a {HOTSPOT}",
                     {"rc": rc, "stderr": msg})


