# Opção de autenticação SSH por senha (página “Mais” do Studio). A imagem vem configurada para aceitar somente chaves e não inclui chaves de terceiros; o usuário define a própria senha na interface antes de ativar o recurso.
# Não há senha padrão conhecida por todos: a senha do ponto de acesso é pública, então uma senha padrão deixaria o acesso aberto a pessoas próximas.
def ssh_password_on(ctx):
    return os.path.isfile(ctx.p(SSH_PASSWORD_CONF))


def ssh_key_count(ctx):
    try:
        with open(ctx.p(SSH_KEYS), encoding="utf-8", errors="replace") as f:
            return sum(1 for line in f if line.strip() and not line.lstrip().startswith("#"))
    except OSError:
        return 0


def ssh_effective_password(op):
    """Lê a configuração efetiva de passwordauthentication com sshd -T: True, False ou None se não for possível consultar."""
    rc, out, err = op.ctx.run(["sshd", "-T"], timeout=10.0)
    if rc != 0:
        return None
    for line in (out or "").splitlines():
        parts = line.strip().split()
        if len(parts) == 2 and parts[0].lower() == "passwordauthentication":
            return parts[1].lower() == "yes"
    return None


def verb_ssh_status(op, args):
    check_keys(args, ("by",), "parâmetros de ssh-status")
    if "by" in args:
        op.by = check_by(args)
    rc, out, _ = op.ctx.run(["systemctl", "is-active", "ssh"], timeout=5.0)
    detail = {"password_login": ssh_password_on(op.ctx), "ssh_active": (out or "").strip() == "active",
              "keys": ssh_key_count(op.ctx), "user": SSH_USER}
    return op.finish(EXIT_OK, "ssh_status", "Estado do SSH lido", detail, record=False)


def check_ssh_password(pw):
    if not isinstance(pw, str):
        raise Stop(EXIT_ARGS, "bad_args", "password deve ser uma string")
    if not SSH_PW_MIN <= len(pw) <= SSH_PW_MAX:
        raise Stop(EXIT_ARGS, "bad_password", f"A senha SSH deve ter entre {SSH_PW_MIN} e {SSH_PW_MAX} caracteres")
    if any(ord(c) < 32 or ord(c) == 127 for c in pw):
        raise Stop(EXIT_ARGS, "bad_password", "A senha SSH não pode conter caracteres de controle, como quebra de linha ou tabulação")
    if pw.strip().lower() in SSH_PW_BANNED:
        raise Stop(EXIT_ARGS, "bad_password", "Essa senha é fácil de adivinhar; escolha outra")
    return pw


def ssh_reload(op):
    rc, out, err = op.ctx.run(["systemctl", "reload-or-restart", "ssh"], timeout=20.0)
    if rc != 0:
        return (err or out or "").strip()[:400] or f"systemctl código de saída {rc}"
    return None


def verb_ssh_password(op, args):
    check_keys(args, ("by", "on", "password"), "parâmetros de ssh-password")
    op.by = check_by(args)
    on = args.get("on")
    if not isinstance(on, bool):
        raise Stop(EXIT_ARGS, "bad_args", "on deve ser true (ativar) ou false (desativar)")
    if not on and "password" in args:
        raise Stop(EXIT_ARGS, "bad_args", "Não informe uma senha ao desativar o acesso SSH por senha")
    pw = check_ssh_password(args.get("password")) if on else None
    op.take_lock("configuração de SSH", SSH_LOCK)
    conf = op.ctx.p(SSH_PASSWORD_CONF)
    if not on:
        existed = os.path.isfile(conf)
        if existed:
            os.remove(conf)
            op.emit("ssh", "info", "Arquivo de configuração do acesso SSH por senha removido", {"path": SSH_PASSWORD_CONF})
        why = ssh_reload(op)
        if why:
            return op.finish(EXIT_FAIL, "reload_failed", f"Arquivo removido, mas o SSH não foi recarregado: {why} (reiniciar o Microduck também aplicará a alteração)",
                             {"password_login": False})
        return op.finish(EXIT_OK, "ssh_password_off", "Acesso SSH por senha desativado; somente chaves são aceitas" if existed else "O acesso SSH por senha já estava desativado",
                         {"password_login": False, "keys": ssh_key_count(op.ctx)})
    # 1. Define a senha: chpasswd lê “usuário:senha” de stdin; ela não aparece na linha de comando (visível por ps) nem nos registros.
    rc, out, err = op.ctx.run(["chpasswd"], input=f"{SSH_USER}:{pw}\n".encode("utf-8"), timeout=15.0)
    if rc != 0:
        why = (err or out or "").strip()[:300] or f"código de saída {rc}"
        return op.finish(EXIT_FAIL, "chpasswd_failed", f"Não foi possível definir a senha de {SSH_USER}: {why}")
    op.emit("ssh", "info", f"Senha de {SSH_USER} definida (o valor da senha não é registrado)")
    # 2. Arquivo de configuração
    ensure_dir(op.ctx, "/etc/ssh/sshd_config.d", 0o755)
    body = ("# Acesso SSH por senha ativado pela página “Mais” do Microduck Studio (microduck-helper ssh-password).\n"
            "# Para desativar, clique em “Desativar acesso SSH por senha” no Studio ou remova este arquivo e execute systemctl reload ssh.\n"
            "PasswordAuthentication yes\n")
    write_atomic(op.ctx, SSH_PASSWORD_CONF, body.encode("utf-8"), 0o644)
    # 3. Valida antes de aplicar; se a sintaxe for inválida ou outra configuração impedir o acesso por senha, reverte a alteração.
    rc, out, err = op.ctx.run(["sshd", "-t"], timeout=10.0)
    if rc != 0:
        os.remove(conf)
        why = (err or out or "").strip()[:400] or f"código de saída {rc}"
        return op.finish(EXIT_FAIL, "sshd_config_bad", f"A validação da configuração sshd falhou; alteração revertida: {why}")
    eff = ssh_effective_password(op)
    if eff is not True:
        os.remove(conf)
        return op.finish(EXIT_FAIL, "not_effective",
                         "O sshd ainda informa que o acesso por senha está desativado (outra configuração prevalece); alteração revertida" if eff is False
                         else "Não foi possível ler a configuração efetiva do sshd; alteração revertida", {"effective": eff})
    why = ssh_reload(op)
    if why:
        os.remove(conf)
        ssh_reload(op)
        return op.finish(EXIT_FAIL, "reload_failed", f"O SSH não foi recarregado; alteração revertida: {why}")
    return op.finish(EXIT_OK, "ssh_password_on", f"Acesso SSH por senha ativado para o usuário {SSH_USER}; use a senha que acabou de definir",
                     {"password_login": True, "user": SSH_USER})


