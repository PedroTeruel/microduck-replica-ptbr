# systemd

def show(op, unit, props):
    argv = ["systemctl", "show", unit]
    for prop in props:
        argv += ["-p", prop]
    _, out, _ = op.ctx.run(argv)
    d = {}
    for line in out.splitlines():
        k, sep, v = line.partition("=")
        if sep:
            d[k.strip()] = v.strip()
    return d


def robotd_state(op):
    return show(op, "robotd", ["ActiveState", "SubState", "Result", "ConditionResult"])


def running(st):
    return st.get("ActiveState") in ("active", "activating", "reloading", "deactivating")


def stopped(st):
    return st.get("ActiveState") in ("inactive", "failed")


def is_active(op, unit):
    _, out, _ = op.ctx.run(["systemctl", "is-active", unit])
    return out.strip() == "active"


def is_enabled(op, unit):
    _, out, _ = op.ctx.run(["systemctl", "is-enabled", unit])
    return out.strip() == "enabled"


def guard_installed(op):
    paths = show(op, "robotd", ["DropInPaths"]).get("DropInPaths", "")
    if DROPIN_NAME not in paths.split() and not any(p.endswith("/" + DROPIN_NAME) for p in paths.split()):
        raise Stop(EXIT_STATE, "no_guard", "A proteção não está instalada: o drop-in zzzz-studio-bus.conf do robotd não foi aplicado (execute daemon-reload após instalá-lo)."
                                            "Sem essa proteção, o programa principal pode iniciar depois de assumir o barramento e ambos podem gravá-lo ao mesmo tempo.",
                   {"DropInPaths": paths})
    if not exists(op.ctx, DROPIN):
        raise Stop(EXIT_STATE, "no_guard", f"A proteção não está instalada: {DROPIN} não existe")


# Lock de gerenciamento: a unidade temporária microduck-bus-hold mantém /run/microduck-service-management.lock continuamente.

def hold_active(op):
    return show(op, HOLD_UNIT, ["ActiveState"]).get("ActiveState") == "active"


def hold_start(op):
    """Inicia microduck-bus-hold. Retorna True quando iniciar e permanecer ativo. flock -n encerra imediatamente se não conseguir o lock; por isso, verifica o estado active duas vezes."""
    rc, _, err = op.ctx.run(["systemd-run", f"--unit={HOLD_UNIT}", "--collect", "--quiet",
                             "--description=Microduck Studio holds the service-management lock while it owns the servo bus",
                             BIN["flock"], "-n", SERVICE_LOCK, BIN["sleep"], "infinity"])
    if rc != 0:
        op.emit("lock", "warn", "Falha ao iniciar a unidade de lock de gerenciamento", {"rc": rc, "stderr": err.strip()[:300]})
        return False
    for _ in range(2):
        op.ctx.sleep(HOLD_CONFIRM_GAP)
        if not hold_active(op):
            op.ctx.run(["systemctl", "stop", HOLD_UNIT])
            return False
    return True


def hold_stop(op):
    op.ctx.run(["systemctl", "stop", HOLD_UNIT])


# Sinalizador.

def flag_present(ctx):
    return exists(ctx, FLAG)


def flag_write(op, why):
    ensure_dir(op.ctx, HELPER_DIR, 0o755)
    body = {"by": op.by, "boot_id": op.ctx.boot_id(), "mono_ms": int(op.ctx.now() * 1000), "verb": op.verb,
            "why": why}
    write_atomic(op.ctx, FLAG, (json.dumps(body, ensure_ascii=False) + "\n").encode("utf-8"), 0o644)


def port_free(op):
    """Código de saída do fuser: 0 = processo usando o recurso; 1 = nenhum processo usando. Outros valores = não foi possível verificar."""
    rc, out, err = op.ctx.run(["fuser", PORT])
    if rc == 1:
        return True, None
    if rc == 0:
        return False, (out + " " + err).strip()
    return None, f"fuser retornou código {rc}: {(err or out).strip()[:200]}"


def stop_robotd(op, step="stop"):
    """Para robotd com --no-block, verifica a cada 100 ms e envia KILL após 10 s. O sinalizador precisa existir antes do KILL (ele impede a reinicialização automática de Restart=always).
    SIGTERM e KILL não gravam o torque (fork robotd/src/main.rs:1218-1231, 4185-4186)."""
    st = robotd_state(op)
    if stopped(st):
        op.emit(step, "info", "O programa principal já estava parado", st)
        return True
    if not flag_present(op.ctx):
        flag_write(op, "garantir o sinalizador antes de parar o programa principal")
    op.ctx.run(["systemctl", "stop", "--no-block", "robotd"])
    deadline = op.ctx.now() + STOP_WAIT
    while op.ctx.now() < deadline:
        op.ctx.sleep(POLL)
        st = robotd_state(op)
        if stopped(st):
            op.emit(step, "info", "Programa principal parado (SIGTERM; torque não foi alterado)", st)
            return True
    op.emit(step, "warn", f"O programa principal não parou em {STOP_WAIT:.0f} s; enviando KILL (KILL também não altera o torque)", st)
    if not flag_present(op.ctx):
        flag_write(op, "garantir o sinalizador antes de KILL")
    op.ctx.run(["systemctl", "kill", "-s", "KILL", "robotd"])
    deadline = op.ctx.now() + KILL_WAIT
    while op.ctx.now() < deadline:
        op.ctx.sleep(POLL)
        st = robotd_state(op)
        if stopped(st):
            op.emit(step, "info", "Programa principal parou após KILL", st)
            return True
    op.emit(step, "error", "O programa principal continua em execução após KILL", st)
    return False


# Controles: padd, gamesir-xboxd.

def pads_stop(op):
    was = {"padd": is_active(op, "padd"), "gamesir": is_active(op, GAMESIR)}
    for unit in ("padd", GAMESIR):
        if was["padd" if unit == "padd" else "gamesir"]:
            op.ctx.run(["systemctl", "stop", unit])
    op.emit("pads", "info", "Parando os serviços do controle: ele não pode reativar a rotina entre a verificação do estado e a parada do programa principal", was)
    return was


def pads_restore(op, was):
    if was.get("padd"):
        op.ctx.run(["systemctl", "start", "--no-block", "padd"])
    if was.get("gamesir"):
        op.ctx.run(["systemctl", "start", "--no-block", GAMESIR])
    op.emit("pads", "info", "Serviços do controle restaurados ao estado anterior", was)


def pads_start(op):
    """Após devolver o barramento, inicia padd (seu startup_gate aguarda o sucesso das quatro etapas de robotd); inicia gamesir somente se estiver habilitado."""
    op.ctx.run(["systemctl", "reset-failed", "padd"])
    op.ctx.run(["systemctl", "start", "--no-block", "padd"])
    gs = is_enabled(op, GAMESIR)
    if gs:
        op.ctx.run(["systemctl", "start", "--no-block", GAMESIR])
    op.emit("pads", "info", "Serviços do controle iniciados", {"padd": True, "gamesir": gs})


