# /etc/sudoers.d/microduck-studio (root:root 0440). Antes de instalar, valide este arquivo com visudo -cf.
# Autoriza somente o caminho completo do assistente; ele valida os comandos permitidos (incluindo calib-read, calib-commit e imu-recalibrate) e recebe argumentos por stdin. Por padrão, sudo usa env_reset e não repassa as variáveis de ambiente do chamador.
# Durante o teste, o Studio é executado como radxa (studio-trial). Ao mudar para o usuário dedicado microduck-studio, inverta os comentários das duas linhas abaixo.
radxa ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
#microduck-studio ALL=(root) NOPASSWD: /usr/local/sbin/microduck-helper
